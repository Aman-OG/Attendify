<UserControl x:Class="Attendify.Views.UserControls.EmployeeReportsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:oxy="http://oxyplot.org/wpf"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1000"
             Background="Transparent">

    <UserControl.Resources>
        <!-- Reuse the same styles from admin reports -->
        <Style x:Key="GlassRoundedBorder" TargetType="Border">
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#33FFFFFF" Offset="0" />
                        <GradientStop Color="#13FFFFFF" Offset="1" />
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="BorderBrush" Value="#30FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="15"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="18" Opacity="0.18" ShadowDepth="2"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- KPI Card Style -->
        <Style x:Key="KpiCardStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#40FFFFFF" Offset="0"/>
                        <GradientStop Color="#20FFFFFF" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="BorderBrush" Value="#60FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Width" Value="180"/>
            <Setter Property="Height" Value="90"/>
            <Setter Property="Margin" Value="8"/>
            <Setter Property="Padding" Value="15"/>
        </Style>

        <!-- Export Button Style -->
        <Style x:Key="ExportButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#20FFFFFF"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" 
                                CornerRadius="8"
                                Background="{TemplateBinding Background}"
                                BorderBrush="#40FFFFFF"
                                BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#4000A6FB"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Rounded Button Style -->
        <Style x:Key="RoundedButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#00A6FB"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" 
                                CornerRadius="8"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#0088CC"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern DatePicker Style -->
        <Style x:Key="ModernDatePicker" TargetType="DatePicker">
            <Setter Property="Background" Value="#20FFFFFF"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#40FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Height" Value="25"/>
            <Setter Property="Width" Value="140"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <!-- OxyPlot Style -->
        <Style x:Key="OxyPlotChartStyle" TargetType="oxy:PlotView">
            <Setter Property="Height" Value="220"/>
            <Setter Property="Background" Value="Transparent"/>
        </Style>

        <!-- DataGrid Style -->
        <Style x:Key="ModernDataGrid" TargetType="DataGrid">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#40FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="RowBackground" Value="Transparent"/>
            <Setter Property="AlternatingRowBackground" Value="#10FFFFFF"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="CanUserReorderColumns" Value="False"/>
            <Setter Property="CanUserResizeRows" Value="False"/>
            <Setter Property="CanUserSortColumns" Value="True"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#20FFFFFF"/>
            <Setter Property="VerticalGridLinesBrush" Value="Transparent"/>
        </Style>

        <Style x:Key="DataGridColumnHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#2000A6FB"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#40FFFFFF"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Height" Value="35"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="10,5"/>
        </Style>

        <Style x:Key="DataGridTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Padding" Value="10,5"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20">
        <StackPanel>
            <!-- Header -->
            <TextBlock Text="👤 My Attendance Report" 
                       FontSize="28" 
                       FontWeight="Bold" 
                       Foreground="#00A6FB" 
                       Margin="0,0,0,20"/>

            <!-- Date Range Filter -->
            <Border Style="{StaticResource GlassRoundedBorder}" Margin="0,0,0,20">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="📅 Date Range:" 
                               Foreground="White" 
                               FontWeight="SemiBold" 
                               FontSize="14"
                               Margin="0,0,15,0"
                               VerticalAlignment="Center"/>

                    <DatePicker x:Name="StartDatePicker" 
                                Style="{StaticResource ModernDatePicker}"
                                Margin="0,0,10,0"
                                Foreground="black" />

                    <TextBlock Text="to" 
                               Foreground="#80FFFFFF" 
                               Margin="0,0,10,0"
                               VerticalAlignment="Center"
                               FontSize="12"/>

                    <DatePicker x:Name="EndDatePicker" 
                                Style="{StaticResource ModernDatePicker}"
                                Margin="0,0,20,0"
                                Foreground="black" />

                    <Button Content="🔍 Apply Filter" 
                            Style="{StaticResource RoundedButtonStyle}"
                            Click="ApplyFilter_Click"/>
                </StackPanel>
            </Border>

            <!-- KPI Cards -->
            <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,25">
                <!-- Attendance Percentage -->
                <Border Style="{StaticResource KpiCardStyle}">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="85%" 
                                   FontSize="24" 
                                   FontWeight="Bold" 
                                   Foreground="#00A6FB" 
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="Attendance Rate" 
                                   FontSize="11" 
                                   Foreground="White" 
                                   HorizontalAlignment="Center"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Days Present -->
                <Border Style="{StaticResource KpiCardStyle}">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="18" 
                                   FontSize="24" 
                                   FontWeight="Bold" 
                                   Foreground="#2FBF4C" 
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="Days Present" 
                                   FontSize="11" 
                                   Foreground="White" 
                                   HorizontalAlignment="Center"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Late Days -->
                <Border Style="{StaticResource KpiCardStyle}">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="6" 
                                   FontSize="24" 
                                   FontWeight="Bold" 
                                   Foreground="#E3C63A" 
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="Late Arrivals" 
                                   FontSize="11" 
                                   Foreground="White" 
                                   HorizontalAlignment="Center"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Days Absent -->
                <Border Style="{StaticResource KpiCardStyle}">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="2" 
                                   FontSize="24" 
                                   FontWeight="Bold" 
                                   Foreground="#D23C3C" 
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="Days Absent" 
                                   FontSize="11" 
                                   Foreground="White" 
                                   HorizontalAlignment="Center"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Leaves Used -->
                <Border Style="{StaticResource KpiCardStyle}">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="3" 
                                   FontSize="24" 
                                   FontWeight="Bold" 
                                   Foreground="#A95315" 
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="Leaves Used" 
                                   FontSize="11" 
                                   Foreground="White" 
                                   HorizontalAlignment="Center"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"/>
                    </StackPanel>
                </Border>
            </WrapPanel>

            <!-- Charts Grid -->
            <Grid Margin="0,0,0,25">
                <Grid.RowDefinitions>
                    <RowDefinition Height="300"/>
                    <RowDefinition Height="300"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Monthly Attendance Bar Chart -->
                <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource GlassRoundedBorder}" Margin="5">
                    <StackPanel>
                        <TextBlock Text="📊 Monthly Attendance Breakdown" 
                                   FontSize="16" 
                                   FontWeight="Bold" 
                                   Foreground="#00A6FB" 
                                   Margin="0,0,0,10"/>
                        <oxy:PlotView Model="{Binding MonthlyAttendanceModel}" 
                                    Style="{StaticResource OxyPlotChartStyle}"/>
                    </StackPanel>
                </Border>

                <!-- Attendance Distribution Pie Chart -->
                <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource GlassRoundedBorder}" Margin="5">
                    <StackPanel>
                        <TextBlock Text="🥧 Overall Attendance Distribution" 
                                   FontSize="16" 
                                   FontWeight="Bold" 
                                   Foreground="#00A6FB" 
                                   Margin="0,0,0,10"/>
                        <oxy:PlotView Model="{Binding AttendanceDistributionModel}" 
                                    Style="{StaticResource OxyPlotChartStyle}"/>
                    </StackPanel>
                </Border>

                <!-- Check-in Time Trend -->
                <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource GlassRoundedBorder}" Margin="5">
                    <StackPanel>
                        <TextBlock Text="⏰ Average Check-in Time Trend" 
                                   FontSize="16" 
                                   FontWeight="Bold" 
                                   Foreground="White" 
                                   Margin="0,0,0,10"/>
                        <oxy:PlotView Model="{Binding CheckinTimeModel}" 
                                    Style="{StaticResource OxyPlotChartStyle}"/>
                    </StackPanel>
                </Border>

                <!-- Performance Gauge -->
                <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource GlassRoundedBorder}" Margin="5">
                    <StackPanel>
                        <TextBlock Text="🎯 Performance Overview" 
                                   FontSize="16" 
                                   FontWeight="Bold" 
                                   Foreground="White" 
                                   Margin="0,0,0,10"/>

                        <!-- Gauge -->
                        <Grid Height="120" Margin="0,0,0,15">
                            <oxy:PlotView Model="{Binding PerformanceGaugeModel}" 
                                        Background="Transparent"/>
                        </Grid>

                        <!-- Performance Stats -->
                        <StackPanel>
                            <TextBlock Text="📋 Quick Stats" 
                                       FontSize="14" 
                                       FontWeight="SemiBold" 
                                       Foreground="White" 
                                       Margin="0,0,0,10"/>
                            <TextBlock Text="• On Time: 74%&#x0a;• Late Arrivals: 26%&#x0a;• Early Departures: 8%&#x0a;• Overtime Hours: 12h" 
                                       FontSize="12" 
                                       Foreground="#CCCCCC" 
                                       TextWrapping="Wrap"
                                       LineHeight="18"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Detailed Report Table -->
            <Border Style="{StaticResource GlassRoundedBorder}" Margin="5">
                <StackPanel>
                    <TextBlock Text="📋 Detailed Monthly Report" 
                               FontSize="16" 
                               FontWeight="Bold" 
                               Foreground="White" 
                               Margin="0,0,0,15"/>

                    <DataGrid x:Name="MonthlyReportGrid" 
                              Style="{StaticResource ModernDataGrid}"
                              ColumnHeaderStyle="{StaticResource DataGridColumnHeaderStyle}"
                              Height="250"
                              ItemsSource="{Binding MonthlyReports}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Month" 
                                                Binding="{Binding Month}" 
                                                Width="*"
                                                ElementStyle="{StaticResource DataGridTextStyle}"/>
                            <DataGridTextColumn Header="Present" 
                                                Binding="{Binding Present}" 
                                                Width="*"
                                                ElementStyle="{StaticResource DataGridTextStyle}"/>
                            <DataGridTextColumn Header="Late" 
                                                Binding="{Binding Late}" 
                                                Width="*"
                                                ElementStyle="{StaticResource DataGridTextStyle}"/>
                            <DataGridTextColumn Header="Absent" 
                                                Binding="{Binding Absent}" 
                                                Width="*"
                                                ElementStyle="{StaticResource DataGridTextStyle}"/>
                            <DataGridTextColumn Header="Leaves Approved" 
                                                Binding="{Binding LeavesApproved}" 
                                                Width="*"
                                                ElementStyle="{StaticResource DataGridTextStyle}"/>
                            <DataGridTextColumn Header="Attendance %" 
                                                Binding="{Binding AttendancePercentage, StringFormat={}{0}%}" 
                                                Width="*"
                                                ElementStyle="{StaticResource DataGridTextStyle}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>

            <!-- Export Section -->
            <Border Style="{StaticResource GlassRoundedBorder}" Margin="5,20,5,0">
                <StackPanel>
                    <TextBlock Text="📤 Export My Reports" 
                               FontSize="16" 
                               FontWeight="Bold" 
                               Foreground="White" 
                               Margin="0,0,0,15"/>

                    <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button Content="📄 Export Attendance Report (PDF)" 
                                Style="{StaticResource ExportButtonStyle}"
                                Click="ExportAttendancePdf_Click"
                                Margin="5"/>

                        <Button Content="📊 Export Monthly Summary (Excel)" 
                                Style="{StaticResource ExportButtonStyle}"
                                Click="ExportMonthlyExcel_Click"
                                Margin="5"/>

                        <Button Content="⏰ Export Time Analysis (CSV)" 
                                Style="{StaticResource ExportButtonStyle}"
                                Click="ExportTimeCsv_Click"
                                Margin="5"/>
                    </WrapPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>