<Window x:Class="Attendify.Views.LandingPage"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="None"
        Width="1200" Height="800"
        Background="#FFF9F5"
        AllowsTransparency="False">

    <Window.Resources>
        <DropShadowEffect x:Key="ButtonShadow"
                      Color="#333"
                      ShadowDepth="2"
                      BlurRadius="8"
                      Opacity="0.3"/>

        <!-- Hover underline style -->
        <Style TargetType="TextBlock" x:Key="HoverLink">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="#2979FF"/>
            <Setter Property="TextDecorations" Value="None"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="TextDecorations" Value="Underline"/>
                    <Setter Property="Foreground" Value="#5CA5FF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Glass Liquid Card Style -->
        <Style TargetType="Border" x:Key="GlassCardStyle">
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#45FFFFFF" Offset="0"/>
                        <GradientStop Color="#25FFFFFF" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="CornerRadius" Value="20"/>
            <Setter Property="Width" Value="250"/>
            <Setter Property="Height" Value="220"/>
            <Setter Property="Margin" Value="20"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="BorderBrush" Value="#80FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="20" ShadowDepth="2" Opacity="0.15" Color="#333333"/>
                </Setter.Value>
            </Setter>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <EventTrigger RoutedEvent="MouseEnter">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)"
                                             To="1.05" Duration="0:0:0.15"/>
                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)"
                                             To="1.05" Duration="0:0:0.15"/>
                            <ColorAnimation Storyboard.TargetProperty="Background.(LinearGradientBrush.GradientStops)[0].Color"
                                            To="#A0FFFFFF" Duration="0:0:0.15"/>
                            <ColorAnimation Storyboard.TargetProperty="Background.(LinearGradientBrush.GradientStops)[1].Color"
                                            To="#60FFFFFF" Duration="0:0:0.15"/>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
                <EventTrigger RoutedEvent="MouseLeave">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)"
                                             To="1" Duration="0:0:0.15"/>
                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)"
                                             To="1" Duration="0:0:0.15"/>
                            <ColorAnimation Storyboard.TargetProperty="Background.(LinearGradientBrush.GradientStops)[0].Color"
                                            To="#80FFFFFF" Duration="0:0:0.15"/>
                            <ColorAnimation Storyboard.TargetProperty="Background.(LinearGradientBrush.GradientStops)[1].Color"
                                            To="#40FFFFFF" Duration="0:0:0.15"/>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <!-- Background Image -->
        <Image Source="/Assets/Images/landing.jpg" Stretch="Fill"/>

        <!-- MAIN LAYOUT -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- TOP AREA (Logo + Login + Close Button) -->
            <Grid Margin="30" Height="80">
                <!-- LOGO LEFT -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left">
                    <TextBlock Text="Attendify"
                               Margin="15,0,0,0"
                               FontFamily="Montserrat"
                               FontWeight="Bold"
                               FontSize="40"
                               VerticalAlignment="Center"
                               Foreground="#2979FF"/>
                </StackPanel>

                <!-- LOGIN BUTTON RIGHT -->
                <Border x:Name="LoginButton" 
                    Background="#2979FF"
                        CornerRadius="25"
                        Padding="25,10"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Right"
                        Cursor="Hand"
                        Effect="{DynamicResource ButtonShadow}"
                        MouseEnter="LoginButton_MouseEnter"
                        MouseLeave="LoginButton_MouseLeave"
                        MouseDown="Login_Click">
                    <Border.RenderTransform>
                        <ScaleTransform ScaleX="1" ScaleY="1"/>
                    </Border.RenderTransform>
                    <TextBlock Text="Log in"
                               FontFamily="Montserrat"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="White"
                               HorizontalAlignment="Center"/>
                </Border>

                <!-- CLOSE BUTTON TOP-RIGHT -->
                <Button Content="✕"
                        Width="35" Height="35"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Background="#20FFFFFF"
                        Foreground="White"
                        Margin="0,-30,-30,0"
                        BorderThickness="0"
                        FontSize="16"
                        Cursor="Hand"
                        Click="Close_Click">
                    <Button.Effect>
                        <DropShadowEffect BlurRadius="7" Opacity="0.8"/>
                    </Button.Effect>
                </Button>
            </Grid>

            <!-- MAIN CONTENT -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel HorizontalAlignment="Center">
                    <!-- WELCOME -->
                    <TextBlock Text="👋  Welcome"
                               FontFamily="Montserrat"
                               FontSize="36"
                               Foreground="AliceBlue"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"
                               Margin="0,40,0,0"/>

                    <TextBlock Text="Attendify — your all-in-one attendance and leave management app designed to simplify tracking, approvals, and employee scheduling with ease."
                               FontFamily="Montserrat"
                               FontSize="18"
                               Foreground="AliceBlue"
                               TextWrapping="Wrap"
                               Width="900"
                               TextAlignment="Center"
                               Margin="0,10,0,0"/>

                    <!-- FEATURE CARDS -->
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                Margin="0,40,0,0">

                        <!-- CARD 1 -->
                        <Border Style="{StaticResource GlassCardStyle}">
                            <StackPanel>
                                <Image Source="/Assets/Images/attendance.png"
                                       Width="70" Height="70" HorizontalAlignment="Center"/>
                                <TextBlock Text="Simplify attendance tracking with real-time monitoring and automated records."
                                           Margin="0,15,0,0"
                                           FontFamily="Montserrat"
                                           FontSize="14"
                                           
                                           Foreground="white"
                                           TextWrapping="Wrap"
                                           FontWeight="Light"/>
                            </StackPanel>
                        </Border>

                        <!-- CARD 2 -->
                        <Border Style="{StaticResource GlassCardStyle}">
                            <StackPanel>
                                <Image Source="/Assets/Images/ask-question.png"
                                       Width="70" Height="70" HorizontalAlignment="Center"/>
                                <TextBlock Text="Streamline leave requests and approvals for faster, hassle-free management."
                                           Margin="0,15,0,0"
                                           FontFamily="Montserrat"
                                           FontSize="14"
                                           Foreground="AliceBlue"
                                           
                                           TextWrapping="Wrap"
                                           FontWeight="Light"/>
                            </StackPanel>
                        </Border>

                        <!-- CARD 3 -->
                        <Border Style="{StaticResource GlassCardStyle}">
                            <StackPanel>
                                <Image Source="/Assets/Images/stats.png"
                                       Width="70" Height="70" HorizontalAlignment="Center"/>
                                <TextBlock Text="Provide clear insights and reports to help organizations stay organized and efficient."
                                           Margin="0,15,0,0"
                                           FontFamily="Montserrat"
                                           FontSize="14"
                                           Foreground="AliceBlue"
                                           TextWrapping="Wrap"
                                           FontWeight="Light"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- LEARN MORE -->
                    <TextBlock Text="Learn More About Attendify"
                               Style="{StaticResource HoverLink}"
                               Margin="0,40,0,0"
                               MouseDown="LearnMore_Click"/>
                </StackPanel>
            </ScrollViewer>

            <!-- Fade-in animation -->
            <Grid.Triggers>
                <EventTrigger RoutedEvent="Loaded">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                             From="0" To="1" Duration="0:0:1.2"/>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Grid.Triggers>

        </Grid>
    </Grid>
</Window>