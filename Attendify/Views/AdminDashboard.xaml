<Window x:Class="Attendify.Views.AdminDashboard"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Admin dashboard"
        WindowStartupLocation="CenterScreen"
        Width="1200" Height="780"
        ResizeMode="CanResize"
        Background="#010D2A"
        MinWidth="1000" MinHeight="650">

    <Window.Resources>
        <!-- Brushes -->
        <RadialGradientBrush x:Key="MainRadial" GradientOrigin="0.3,0.2" Center="0.5,0.5" RadiusX="1" RadiusY="1">
            <GradientStop Color="#035399" Offset="0"/>
            <GradientStop Color="#010D2A" Offset="1"/>
        </RadialGradientBrush>

        <SolidColorBrush x:Key="SidebarBrush" Color="#010D2A"/>
        <SolidColorBrush x:Key="AccentBlue" Color="#00A6FB"/>
        <SolidColorBrush x:Key="LightText" Color="#FFFFFF"/>

        <!-- Glass container style: blurred background effect is simulated by semi-transparent gradient + shadow.
             IMPORTANT: we do NOT use BlurEffect on the container's content, so text/icons stay sharp. -->
        <ControlTemplate x:Key="GlassContainerTemplate" TargetType="ContentControl">
            <Grid>
                <!-- simulated frosted background -->
                <Border CornerRadius="10">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#33FFFFFF" Offset="0" />
                            <GradientStop Color="#13FFFFFF" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <Border.Effect>
                        <!-- soft shadow to give depth -->
                        <DropShadowEffect BlurRadius="18" Opacity="0.18" ShadowDepth="2"/>
                    </Border.Effect>
                </Border>

                <!-- foreground content (sharp) -->
                <Border CornerRadius="10" Padding="12" Background="#22FFFFFF" BorderBrush="#40FFFFFF" BorderThickness="1">
                    <ContentPresenter />
                </Border>
            </Grid>
        </ControlTemplate>

        <!-- Sidebar button style -->
        <Style x:Key="SidebarButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#D9EAFE"/>
            <Setter Property="Padding" Value="10 8"/>
            <Setter Property="Margin" Value="6 6"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="Bg" CornerRadius="8" Background="Transparent" />
                            <ContentPresenter Margin="8,0,6,0" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#11296B" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#1A2B4F" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        
        <!-- GLASS EFFECT COMBOBOX -->
<Style x:Key="GlassComboBox" TargetType="ComboBox">
    <Setter Property="SnapsToDevicePixels" Value="True"/>
    <Setter Property="Foreground" Value="White"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Padding" Value="8,4"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Template">
        <Setter.Value>
            <ControlTemplate TargetType="ComboBox">

                <Grid>
                    <!-- Frosted background -->
                    <Border CornerRadius="10"
                            Background="#20FFFFFF"
                            BorderBrush="#40FFFFFF"
                            BorderThickness="1"/>

                    <!-- Main toggle area -->
                    <Grid Margin="6,2,30,2">
                        <ContentPresenter VerticalAlignment="Center" />
                    </Grid>

                    <!-- Dropdown arrow -->
                    <Path Fill="White" Data="M 0 0 L 8 0 L 4 4 Z"
                          HorizontalAlignment="Right"
                          Margin="0,0,12,0"
                          VerticalAlignment="Center"/>
                </Grid>

                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Opacity" Value="0.85"/>
                    </Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate>
        </Setter.Value>
    </Setter>
</Style>

    </Window.Resources>

    <Grid>
        <!-- background radial -->
        <Border Background="{StaticResource MainRadial}" />

        <!-- decorative uploaded background, low opacity -->
        <Image Source="/Assets/Images/adminbackground.png"
               Opacity="0.10"
               Stretch="UniformToFill"
               IsHitTestVisible="False" />

        <!-- layout: sidebar | splitter | main -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260" x:Name="SidebarColumn"/>
                <ColumnDefinition Width="6"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- SIDEBAR -->
            <Border Grid.Column="0" Background="{StaticResource SidebarBrush}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Title -->
                    <StackPanel Orientation="Horizontal" Margin="18" VerticalAlignment="Top" Height="72">
                        <TextBlock Text="Attendify" Foreground="{StaticResource AccentBlue}" FontSize="30" FontWeight="Bold" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Buttons area with sliding indicator -->
                    <Grid Grid.Row="1" Margin="8,12,8,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="8"/>
                            <!-- indicator column -->
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- indicator -->
                        <Border x:Name="SideIndicator" Grid.Column="0" Background="{StaticResource AccentBlue}"
                                CornerRadius="4" Width="8" Height="26" VerticalAlignment="Top" Margin="7,2,0,0" Grid.ColumnSpan="2" HorizontalAlignment="Left">
                            <Border.RenderTransform>
                                <TranslateTransform x:Name="IndicatorTransform" Y="0" />
                            </Border.RenderTransform>
                        </Border>

                        <StackPanel Grid.Column="1" x:Name="SidebarButtonsPanel">
                            <Button x:Name="BtnAttendance" Style="{StaticResource SidebarButton}" Click="BtnAttendance_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="📅" FontSize="20" Margin="0,0,10,0"/>
                                    <TextBlock Text="Attendance" FontSize="20"/>
                                </StackPanel>
                            </Button>

                            <Button x:Name="BtnLeave" Style="{StaticResource SidebarButton}" Click="BtnLeave_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="⏱" FontSize="20" Margin="0,0,10,0"/>
                                    <TextBlock Text="Leave Requests" FontSize="20"/>
                                </StackPanel>
                            </Button>

                            <Button x:Name="BtnEmployees" Style="{StaticResource SidebarButton}" Click="BtnEmployees_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="👥" FontSize="20" Margin="0,0,10,0"/>
                                    <TextBlock Text="Employees" FontSize="20"/>
                                </StackPanel>
                            </Button>

                            <Button x:Name="BtnReports" Style="{StaticResource SidebarButton}" Click="BtnReports_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="📊" FontSize="20" Margin="0,0,10,0"/>
                                    <TextBlock Text="Reports" FontSize="20"/>
                                </StackPanel>
                            </Button>

                            <Button x:Name="BtnSettings" Style="{StaticResource SidebarButton}" Click="BtnSettings_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="⚙" FontSize="20" Margin="0,0,10,0"/>
                                    <TextBlock Text="Settings" FontSize="20"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- bottom: profile initial + name and account button -->
                    <Border Grid.Row="2" Padding="14" Background="Transparent">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
                            <Border Width="44" Height="44" CornerRadius="22" Background="#D93A3A" VerticalAlignment="Center">
                                <TextBlock x:Name="ProfileInitial" Text="A" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>

                            <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock x:Name="ProfileName" Text="Aman" Foreground="White" FontWeight="Bold"/>
                                <Button x:Name="AccountBtn" Content="Admin ▾" Background="Transparent" BorderThickness="0" Foreground="#A6C6F5" Click="AccountBtn_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- GridSplitter to allow user-moving sidebar -->
            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" Background="#01243A" ShowsPreview="True"/>

            <!-- MAIN AREA -->
            <!-- MAIN AREA -->
            <Border Grid.Column="2" Padding="20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <StackPanel Orientation="Horizontal" Grid.Row="0" VerticalAlignment="Center" Margin="6">
                        <TextBlock Text="Admin dashboard" FontSize="26" FontWeight="Bold" Foreground="White" Margin="0,0,24,0"/>
                        <TextBlock x:Name="AttendanceTitle" Text="Employee Attendance - Day" FontSize="20" Foreground="White" VerticalAlignment="Center" Margin="0,2,6,0"/>
                        <TextBlock x:Name="DateText" Text="--" Foreground="{StaticResource AccentBlue}" FontSize="20" FontWeight="Bold" Margin="8,0,12,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="ShiftText" Text="Morning Shift" Foreground="White" FontSize="20" FontWeight="Bold" Margin="6,0,12,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="ClockText" Text="00 : 00 : 00" Foreground="#64FF33" FontSize="20" FontWeight="Bold" Margin="6,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Filters (glass container) -->
                    <!-- Filters (glass container) -->
                    <ContentControl Grid.Row="1"
                Margin="0,12,0,12"
                Template="{StaticResource GlassContainerTemplate}">

                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Height="64">

                            <!-- SEARCH BOX -->
                            <Grid Width="360" Height="40" Margin="8" VerticalAlignment="Center">
                                <Border CornerRadius="10"
                    Background="#20FFFFFF"
                    BorderBrush="#40FFFFFF"
                    BorderThickness="1"/>
                                <TextBox x:Name="SearchBox"
                     Margin="10,0,0,0"
                     Background="Transparent"
                     BorderThickness="0"
                     VerticalContentAlignment="Center"
                     Foreground="White"
                     TextChanged="SearchBox_TextChanged"/>
                                <TextBlock x:Name="SearchPlaceholder"
                       Text="Search Employees"
                       Foreground="#B0CFF7"
                       Margin="18,0,0,0"
                       VerticalAlignment="Center"
                       IsHitTestVisible="False"/>
                            </Grid>

                            <!-- STATUS COMBOBOX (GLASS) -->
                            <ComboBox x:Name="StatusCombo"
                  Width="180" Height="40"
                  Margin="8"
                  Style="{StaticResource GlassComboBox}" SelectedIndex="0" >
                                <ComboBoxItem>All</ComboBoxItem>
                                <ComboBoxItem>Attended</ComboBoxItem>
                                <ComboBoxItem>Late</ComboBoxItem>
                                <ComboBoxItem>On Leave</ComboBoxItem>
                            </ComboBox>

                            <!-- DEPARTMENT COMBOBOX (GLASS) -->
                            <ComboBox x:Name="DeptCombo"
                  Width="180" Height="40"
                  Margin="8"
                  Style="{StaticResource GlassComboBox}" SelectedIndex="0" >
                                <ComboBoxItem>All</ComboBoxItem>
                                <ComboBoxItem>Software</ComboBoxItem>
                                <ComboBoxItem>Electrical</ComboBoxItem>
                                <ComboBoxItem>Chemical</ComboBoxItem>
                            </ComboBox>

                        </StackPanel>
                    </ContentControl>


                    <!-- Table: glass container holding DataGrid -->
                    <ContentControl Grid.Row="2" Template="{StaticResource GlassContainerTemplate}">
                        <Grid>
                            <DataGrid x:Name="EmployeesGrid"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          IsReadOnly="True"
                          Background="Transparent"
                          RowBackground="#40FFFFFF"
                          AlternatingRowBackground="#30FFFFFF"
                          GridLinesVisibility="None"
                          HorizontalGridLinesBrush="#25FFFFFF"
                          VerticalGridLinesBrush="#25FFFFFF"
                          Foreground="#022"
                          BorderThickness="0" >
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="No." Binding="{Binding No}" Width="60"/>
                                    <DataGridTextColumn Header="Emp ID" Binding="{Binding EmpID}" Width="120"/>
                                    <DataGridTextColumn Header="First Name" Binding="{Binding FirstName}" Width="140"/>
                                    <DataGridTextColumn Header="Last Name" Binding="{Binding LastName}" Width="140"/>
                                    <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="200"/>
                                    <DataGridTextColumn Header="Department" Binding="{Binding Department}" Width="120"/>
                                    <DataGridTextColumn Header="Position" Binding="{Binding Position}" Width="120"/>
                                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="100"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </ContentControl>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
