<UserControl x:Class="Attendify.Views.UserControls.ProfileViewer"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:views="clr-namespace:Attendify.Views"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="800"
             Background="Transparent">

    <UserControl.Resources>
        <!-- Glass liquid container style -->
        <Style x:Key="GlassLiquidContainerStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="20"/>
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#15FFFFFF" Offset="0"/>
                        <GradientStop Color="#08FFFFFF" Offset="0.5"/>
                        <GradientStop Color="#15FFFFFF" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="BorderBrush">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#30FFFFFF" Offset="0"/>
                        <GradientStop Color="#15FFFFFF" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="25" Opacity="0.25" ShadowDepth="3" Direction="320"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Profile Card Style -->
        <Style x:Key="ProfileCardStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#10FFFFFF" Offset="0"/>
                        <GradientStop Color="#08FFFFFF" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="BorderBrush" Value="#20FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="12" Opacity="0.15" ShadowDepth="1"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Info Label Style -->
        <Style x:Key="InfoLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#CCCCCC"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>

        <!-- Info Value Style -->
        <Style x:Key="InfoValueStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Margin" Value="0,0,0,15"/>
        </Style>

        <!-- Section Header Style -->
        <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#00A6FB"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,0,0,15"/>
        </Style>

        <!-- Modern Button Style -->
        <Style x:Key="ModernButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#15FFFFFF"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#30FFFFFF"/>
            <Setter Property="Padding" Value="15,10"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#25FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#35FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- BooleanToVisibility Converter -->
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>

        <!-- Color converter for profile circle -->
        <x:Array x:Key="ProfileColors" Type="Color">
            <Color>#D93A3A</Color>
            <!-- Red -->
            <Color>#3A7BD9</Color>
            <!-- Blue -->
            <Color>#3AD952</Color>
            <!-- Green -->
            <Color>#D9A63A</Color>
            <!-- Orange -->
            <Color>#8A3AD9</Color>
            <!-- Purple -->
            <Color>#D93A99</Color>
            <!-- Pink -->
            <Color>#3AD9C4</Color>
            <!-- Teal -->
            <Color>#D9783A</Color>
            <!-- Brown -->
        </x:Array>

    </UserControl.Resources>

    <Border Style="{StaticResource GlassLiquidContainerStyle}" Padding="30">
        <Grid>
            <!-- Main Content Grid -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="280"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Left Column - Profile Header -->
                <Border Grid.Column="0" Style="{StaticResource ProfileCardStyle}" Margin="0,0,20,0">
                    <StackPanel>
                        <!-- Profile Circle -->
                        <Border x:Name="ProfileCircle" 
                                Width="120" 
                                Height="120" 
                                CornerRadius="60"
                                HorizontalAlignment="Center"
                                Margin="0,0,0,20">
                            <Border.Background>
                                <RadialGradientBrush>
                                    <GradientStop Color="#40FFFFFF" Offset="0"/>
                                    <GradientStop Color="#00000000" Offset="1"/>
                                </RadialGradientBrush>
                            </Border.Background>
                            <TextBlock x:Name="ProfileInitial" 
                                       Text="A" 
                                       FontSize="48" 
                                       Foreground="White" 
                                       FontWeight="Bold"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>

                        <!-- Employee Name -->
                        <TextBlock x:Name="ProfileName" 
                                   Text="Loading..." 
                                   FontSize="22" 
                                   FontWeight="Bold" 
                                   Foreground="White" 
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center"
                                   Margin="0,0,0,5"/>

                        <!-- Employee Code -->
                        <TextBlock x:Name="ProfileEmpCode" 
                                   Text="EMP000" 
                                   FontSize="13" 
                                   Foreground="#00A6FB" 
                                   HorizontalAlignment="Center"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,15"/>

                        <!-- Role Badge -->
                        <Border Background="#2000A6FB" 
                                CornerRadius="15" 
                                Padding="15,8"
                                HorizontalAlignment="Center">
                            <TextBlock x:Name="ProfileRole" 
                                       Text="Employee" 
                                       FontSize="12" 
                                       Foreground="#00A6FB" 
                                       FontWeight="Bold"
                                       HorizontalAlignment="Center"/>
                        </Border>

                        <!-- Status Indicator -->
                        <StackPanel Orientation="Horizontal" 
                                    HorizontalAlignment="Center" 
                                    Margin="0,20,0,0">
                            <Ellipse x:Name="StatusIndicator" 
                                     Width="8" 
                                     Height="8" 
                                     Fill="#00A6FB" 
                                     Margin="0,0,8,0"/>
                            <TextBlock x:Name="StatusText" 
                                       Text="Active" 
                                       FontSize="12" 
                                       Foreground="#CCCCCC"/>
                        </StackPanel>

                        <!-- Last Updated -->
                        <TextBlock x:Name="LastUpdatedText" 
                                   Text="Updated just now" 
                                   FontSize="10" 
                                   Foreground="#888888" 
                                   HorizontalAlignment="Center"
                                   Margin="0,30,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Right Column - Profile Details -->
                <Border Grid.Column="1" Style="{StaticResource ProfileCardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Header -->
                        <StackPanel Grid.Row="0" Margin="0,0,0,20">
                            <TextBlock Text="👤 Profile Information" 
                                       Style="{StaticResource SectionHeaderStyle}"/>
                            <TextBlock Text="View and manage your personal information"
                                       FontSize="12"
                                       Foreground="#CCCCCC"/>
                        </StackPanel>

                        <!-- Details Grid -->
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Row 1 -->
                                <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,10,0">
                                    <TextBlock Text="First Name" Style="{StaticResource InfoLabelStyle}"/>
                                    <TextBlock x:Name="TxtFirstName" Style="{StaticResource InfoValueStyle}"/>
                                </StackPanel>

                                <StackPanel Grid.Row="0" Grid.Column="1" Margin="10,0,0,0">
                                    <TextBlock Text="Middle Name" Style="{StaticResource InfoLabelStyle}"/>
                                    <TextBlock x:Name="TxtMiddleName" Style="{StaticResource InfoValueStyle}"/>
                                </StackPanel>

                                <!-- Row 2 -->
                                <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,10,0">
                                    <TextBlock Text="Last Name" Style="{StaticResource InfoLabelStyle}"/>
                                    <TextBlock x:Name="TxtLastName" Style="{StaticResource InfoValueStyle}"/>
                                </StackPanel>

                                <StackPanel Grid.Row="1" Grid.Column="1" Margin="10,0,0,0">
                                    <TextBlock Text="Employee Code" Style="{StaticResource InfoLabelStyle}"/>
                                    <TextBlock x:Name="TxtEmpCode" Style="{StaticResource InfoValueStyle}"/>
                                </StackPanel>

                                <!-- Row 3 -->
                                <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,10,0">
                                    <TextBlock Text="Department" Style="{StaticResource InfoLabelStyle}"/>
                                    <TextBlock x:Name="TxtDepartment" Style="{StaticResource InfoValueStyle}"/>
                                </StackPanel>

                                <StackPanel Grid.Row="2" Grid.Column="1" Margin="10,0,0,0">
                                    <TextBlock Text="Position" Style="{StaticResource InfoLabelStyle}"/>
                                    <TextBlock x:Name="TxtPosition" Style="{StaticResource InfoValueStyle}"/>
                                </StackPanel>

                                <!-- Row 4 -->
                                <StackPanel Grid.Row="3" Grid.Column="0" Margin="0,0,10,0">
                                    <TextBlock Text="Email Address" Style="{StaticResource InfoLabelStyle}"/>
                                    <TextBlock x:Name="TxtEmail" Style="{StaticResource InfoValueStyle}"/>
                                </StackPanel>

                                <StackPanel Grid.Row="3" Grid.Column="1" Margin="10,0,0,0">
                                    <TextBlock Text="Phone Number" Style="{StaticResource InfoLabelStyle}"/>
                                    <TextBlock x:Name="TxtPhone" Style="{StaticResource InfoValueStyle}"/>
                                </StackPanel>

                                <!-- Row 5 -->
                                <StackPanel Grid.Row="4" Grid.Column="0" Margin="0,0,10,0">
                                    <TextBlock Text="Account Created" Style="{StaticResource InfoLabelStyle}"/>
                                    <TextBlock x:Name="TxtCreatedAt" Style="{StaticResource InfoValueStyle}"/>
                                </StackPanel>

                                <StackPanel Grid.Row="4" Grid.Column="1" Margin="10,0,0,0">
                                    <TextBlock Text="Last Password Change" Style="{StaticResource InfoLabelStyle}"/>
                                    <TextBlock x:Name="TxtLastPasswordChange" Style="{StaticResource InfoValueStyle}"/>
                                </StackPanel>

                                <!-- Row 6 - Full Width -->
                                <StackPanel Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,10,0,0">
                                    <TextBlock Text="Account Status" Style="{StaticResource InfoLabelStyle}"/>
                                    <Border x:Name="StatusBadge" 
                                            Background="#2000A6FB" 
                                            CornerRadius="8" 
                                            Padding="15,10"
                                            HorizontalAlignment="Left">
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse x:Name="ActiveIndicator" 
                                                     Width="8" 
                                                     Height="8" 
                                                     Fill="#00A6FB" 
                                                     Margin="0,0,8,0"
                                                     VerticalAlignment="Center"/>
                                            <TextBlock x:Name="TxtAccountStatus" 
                                                       Text="Active" 
                                                       FontSize="13" 
                                                       Foreground="#00A6FB" 
                                                       FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </ScrollViewer>

                        <!-- Action Buttons -->
                        <StackPanel Grid.Row="2" 
                                    Orientation="Horizontal" 
                                    HorizontalAlignment="Right"
                                    Margin="0,20,0,0">
                            <Button x:Name="BtnEditProfile" 
                                    Content="✏️ Edit Profile" 
                                    Style="{StaticResource ModernButtonStyle}"
                                    Click="BtnEditProfile_Click"
                                    Margin="0,0,10,0"/>

                            <Button x:Name="BtnChangePassword" 
                                    Content="🔑 Change Password" 
                                    Style="{StaticResource ModernButtonStyle}"
                                    Click="BtnChangePassword_Click"
                                    Margin="0,0,10,0"/>

                            <Button x:Name="BtnClose" 
                                    Content="✕ Close" 
                                    Style="{StaticResource ModernButtonStyle}"
                                    Background="Transparent"
                                    Click="BtnClose_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <!-- Loading Overlay -->
            <views:LoadingOverlay x:Name="LoadingOverlay" 
                                  Visibility="Collapsed"
                                  Panel.ZIndex="1000"/>
        </Grid>
    </Border>
</UserControl>