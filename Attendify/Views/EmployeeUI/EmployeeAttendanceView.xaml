<UserControl x:Class="Attendify.Views.Employee.EmployeeAttendanceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="800"
             Background="Transparent">

    <UserControl.Resources>
        <!-- Modern Button Style -->
        <Style x:Key="ModernButton" TargetType="Button">
            <Setter Property="Background" Value="#38b000"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="15,10"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#2d8c00"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#237300"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="#666666"/>
                                <Setter Property="Foreground" Value="#AAAAAA"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Glass container style -->
        <ControlTemplate x:Key="GlassContainerTemplate" TargetType="ContentControl">
            <Grid>
                <Border x:Name="MainBorder" CornerRadius="10">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#03FFFFFF" Offset="0" />
                            <GradientStop Color="#01FFFFFF" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="18" Opacity="0.18" ShadowDepth="2"/>
                    </Border.Effect>
                </Border>
                <Border CornerRadius="10" Padding="12" Background="#22FFFFFF" BorderBrush="#40FFFFFF" BorderThickness="1">
                    <ContentPresenter />
                </Border>
            </Grid>
        </ControlTemplate>

        <!-- Stat Card Style -->
        <Style x:Key="StatCardStyle" TargetType="ContentControl">
            <Setter Property="Template" Value="{StaticResource GlassContainerTemplate}"/>
            <Setter Property="Margin" Value="10"/>
            <Setter Property="Height" Value="180"/>
        </Style>

        <!-- DataGrid Style -->
        <Style x:Key="ModernDataGrid" TargetType="DataGrid">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="GridLinesVisibility" Value="None"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
            <Setter Property="ScrollViewer.PanningMode" Value="Both"/>
            <Setter Property="Stylus.IsFlicksEnabled" Value="False"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="SelectionUnit" Value="FullRow"/>
        </Style>

        <!-- DataGridRow Style -->
        <Style x:Key="DataGridRowStyle" TargetType="DataGridRow">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#20dddf00"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#40dddf00"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- DataGrid Column Header Style -->
        <Style x:Key="GlassColumnHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#00A6FB"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="10">
        <StackPanel>
            <!-- Header Section -->
            <ContentControl Template="{StaticResource GlassContainerTemplate}" Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="My Attendance" 
                               Foreground="#00A6FB" 
                               FontSize="24" 
                               FontWeight="Bold"
                               Margin="0,0,0,10"/>
                    <TextBlock Text="Track your daily attendance and view your history" 
                               Foreground="White" 
                               FontSize="14"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </ContentControl>

            <!-- Today's Attendance Card -->
            <ContentControl Template="{StaticResource GlassContainerTemplate}" Margin="0,0,0,20">
                <Grid Margin="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Attendance Details -->
                    <StackPanel Grid.Column="0">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <TextBlock Text="📅" FontSize="16" VerticalAlignment="Center" Foreground="#00A6FB" Margin="0,0,8,0"/>
                            <TextBlock Text="Today's Attendance" 
                                       Foreground="#00A6FB" 
                                       FontSize="18" 
                                       FontWeight="Bold"
                                       VerticalAlignment="Center"/>
                        </StackPanel>

                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Today's Date -->
                            <TextBlock Grid.Row="0" Grid.Column="0" 
                                       Text="Today:" 
                                       Foreground="#CCCCCC" 
                                       FontSize="14"
                                       Margin="0,0,10,8"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" 
                                       x:Name="TxtTodayDate"
                                       Text="Loading..." 
                                       Foreground="White" 
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,8"/>

                            <!-- Shift Details -->
                            <TextBlock Grid.Row="1" Grid.Column="0" 
                                       Text="Shift:" 
                                       Foreground="#CCCCCC" 
                                       FontSize="14"
                                       Margin="0,0,10,8"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" 
                                       x:Name="TxtShiftDetails"
                                       Text="Loading..." 
                                       Foreground="White" 
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,8"/>

                            <!-- Grace Period -->
                            <TextBlock Grid.Row="2" Grid.Column="0" 
                                       Text="Grace Period:" 
                                       Foreground="#CCCCCC" 
                                       FontSize="14"
                                       Margin="0,0,10,8"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" 
                                       x:Name="TxtGracePeriod"
                                       Text="-- min" 
                                       Foreground="#4CAF50" 
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,8"/>

                            <!-- Current Time -->
                            <TextBlock Grid.Row="3" Grid.Column="0" 
                                       Text="Current Time:" 
                                       Foreground="#CCCCCC" 
                                       FontSize="14"
                                       Margin="0,0,10,8"/>
                            <TextBlock Grid.Row="3" Grid.Column="1" 
                                       x:Name="TxtCurrentTime"
                                       Text="--:-- --" 
                                       Foreground="#64FF33" 
                                       FontSize="16"
                                       FontWeight="Bold"
                                       Margin="0,0,0,8"/>
                        </Grid>
                    </StackPanel>

                    <!-- Status Section -->
                    <StackPanel Grid.Column="1" Margin="20,0,20,0" VerticalAlignment="Center">
                        <Border x:Name="StatusBadge" Background="#666666" CornerRadius="8" Padding="10,6" Margin="0,0,0,10">
                            <TextBlock x:Name="StatusText" 
                                       Text="NOT CHECKED IN" 
                                       Foreground="White" 
                                       FontSize="16"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Center"/>
                        </Border>
                        <TextBlock x:Name="LateInfo" 
                                   Text="Waiting for check-in" 
                                   Foreground="#CCCCCC" 
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>

                    <!-- Check In Button -->
                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                        <Button x:Name="BtnCheckIn" 
                                Content="CHECK IN" 
                                Style="{StaticResource ModernButton}"
                                Padding="30,15"
                                FontSize="16"
                                Click="BtnCheckIn_Click"
                                IsEnabled="False"/>

                        <TextBlock x:Name="TxtCheckedInTime" 
                                   Text="" 
                                   Foreground="#38b000" 
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center"
                                   Margin="0,8,0,0"
                                   Visibility="Collapsed"/>
                    </StackPanel>
                </Grid>
            </ContentControl>

            <!-- Attendance History -->
            <ContentControl Template="{StaticResource GlassContainerTemplate}">
                <StackPanel>
                    <TextBlock Text="Attendance History" 
                               Foreground="#00A6FB" 
                               FontSize="18" 
                               FontWeight="Bold"
                               Margin="0,0,0,15"/>

                    <DataGrid x:Name="AttendanceHistoryGrid"
                              Style="{StaticResource ModernDataGrid}"
                              RowStyle="{StaticResource DataGridRowStyle}"
                              ColumnHeaderStyle="{StaticResource GlassColumnHeaderStyle}"
                              AutoGenerateColumns="False"
                              Height="300">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Date" Binding="{Binding Date}" Width="*"/>
                            <DataGridTextColumn Header="Shift" Binding="{Binding Shift}" Width="*"/>
                            <DataGridTextColumn Header="Check In" Binding="{Binding CheckIn}" Width="*"/>
                            <DataGridTemplateColumn Header="Status" Width="120">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Background="{Binding StatusColor}" 
                                                CornerRadius="10" 
                                                Padding="5,2"
                                                HorizontalAlignment="Left">
                                            <TextBlock Text="{Binding Status}" 
                                                       Foreground="White" 
                                                       FontWeight="SemiBold"
                                                       FontSize="11"
                                                       HorizontalAlignment="Center"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </ContentControl>

            <!-- Monthly Stats -->
            <Grid Margin="0,20,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- This Month -->
                <ContentControl Grid.Column="0" Style="{StaticResource StatCardStyle}">
                    <StackPanel Margin="10" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="📅 This Month" 
                                   Foreground="#00A6FB" 
                                   FontSize="14" 
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,10"/>
                        <TextBlock x:Name="DaysPresentCount" 
                                   Text="0" 
                                   Foreground="#38b000" 
                                   FontSize="32" 
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="Days Present" 
                                   Foreground="#CCCCCC" 
                                   FontSize="12"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </ContentControl>

                <!-- On Time Rate -->
                <ContentControl Grid.Column="1" Style="{StaticResource StatCardStyle}">
                    <StackPanel Margin="10" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="⏰ On Time Rate" 
                                   Foreground="#00A6FB" 
                                   FontSize="14" 
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,10"/>
                        <TextBlock x:Name="OnTimeRateCount" 
                                   Text="0%" 
                                   Foreground="#4CAF50" 
                                   FontSize="32" 
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="This Month" 
                                   Foreground="#CCCCCC" 
                                   FontSize="12"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </ContentControl>

                <!-- Late Arrivals -->
                <ContentControl Grid.Column="2" Style="{StaticResource StatCardStyle}">
                    <StackPanel Margin="10" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="⚠️ Late Arrivals" 
                                   Foreground="#00A6FB" 
                                   FontSize="14" 
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,10"/>
                        <TextBlock x:Name="LateArrivalsCount" 
                                   Text="0" 
                                   Foreground="#FF9800" 
                                   FontSize="32" 
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="This Month" 
                                   Foreground="#CCCCCC" 
                                   FontSize="12"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </ContentControl>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>