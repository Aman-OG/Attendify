<UserControl x:Class="Attendify.Views.Employee.EmployeeShiftsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="800"
             Background="Transparent">

    <UserControl.Resources>
        <!-- Modern Button Style -->
        <Style x:Key="ModernButton" TargetType="Button">
            <Setter Property="Background" Value="#38b000"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="15,10"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#2d8c00"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#237300"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Glass container style -->
        <ControlTemplate x:Key="GlassContainerTemplate" TargetType="ContentControl">
            <Grid>
                <Border x:Name="MainBorder" CornerRadius="10">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#10FFFFFF" Offset="0" />
                            <GradientStop Color="#13FFFFFF" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="18" Opacity="0.18" ShadowDepth="2"/>
                    </Border.Effect>
                </Border>
                <Border CornerRadius="10" Padding="12" Background="#22FFFFFF" BorderBrush="#40FFFFFF" BorderThickness="1">
                    <ContentPresenter />
                </Border>
            </Grid>
        </ControlTemplate>

        <!-- Shift Card Style -->
        <Style x:Key="ShiftCardStyle" TargetType="ContentControl">
            <Setter Property="Template" Value="{StaticResource GlassContainerTemplate}"/>
            <Setter Property="Width" Value="300"/>
            <Setter Property="Height" Value="200"/>
            <Setter Property="Margin" Value="10"/>
        </Style>

        <!-- WrapPanel Style for shift cards -->
        <Style x:Key="ShiftCardsPanelStyle" TargetType="WrapPanel">
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
            <Setter Property="Orientation" Value="Horizontal"/>
            <Setter Property="Margin" Value="0,10,0,0"/>
        </Style>

    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="10">
        <StackPanel>
            <!-- Header Section -->
            <ContentControl Template="{StaticResource GlassContainerTemplate}" Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="My Shifts and Schedule" 
                               Foreground="#00A6FB" 
                               FontSize="24" 
                               FontWeight="Bold"
                               Margin="0,0,0,10"/>
                    <TextBlock Text="View your assigned shifts and upcoming schedule" 
                               Foreground="White" 
                               FontSize="14"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </ContentControl>

            <!-- Assigned Shifts Section -->
            <ContentControl Template="{StaticResource GlassContainerTemplate}">
                <StackPanel>
                    <TextBlock Text="🕒 Assigned Shifts" 
                               Foreground="#00A6FB" 
                               FontSize="18" 
                               FontWeight="Bold"
                               Margin="0,0,0,15"/>

                    <!-- Dynamic shift cards container -->
                    <WrapPanel x:Name="AssignedShiftsPanel" 
                               Style="{StaticResource ShiftCardsPanelStyle}"/>

                    <!-- Loading text (hidden when shifts are loaded) -->
                    <TextBlock x:Name="LoadingText"
                               Text="Loading shifts..."
                               Foreground="#CCCCCC"
                               FontSize="14"
                               HorizontalAlignment="Center"
                               Margin="0,20,0,10"
                               Visibility="Collapsed"/>
                </StackPanel>
            </ContentControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>