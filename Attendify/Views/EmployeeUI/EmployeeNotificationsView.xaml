<UserControl x:Class="Attendify.Views.UserControls.EmployeeNotificationsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1000"
             Background="Transparent">

    <UserControl.Resources>
        <!-- Glass container style -->
        <Style x:Key="GlassRoundedBorder" TargetType="Border">
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#33FFFFFF" Offset="0" />
                        <GradientStop Color="#13FFFFFF" Offset="1" />
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="BorderBrush" Value="#30FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="15"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="18" Opacity="0.18" ShadowDepth="2"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Notification Card Style -->
        <Style x:Key="NotificationCardStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#40FFFFFF" Offset="0"/>
                        <GradientStop Color="#20FFFFFF" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="BorderBrush" Value="#40FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="0,0,0,15"/>
            <Setter Property="Padding" Value="20"/>
        </Style>

        <!-- Status Badge Style -->
        <Style x:Key="StatusBadgeStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
        </Style>

        <!-- Filter Button Style -->
        <Style x:Key="FilterButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#20FFFFFF"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" 
                                CornerRadius="6"
                                Background="{TemplateBinding Background}"
                                BorderBrush="#40FFFFFF"
                                BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#4000A6FB"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Important Notification Style -->
        <Style x:Key="ImportantNotificationStyle" TargetType="Border" BasedOn="{StaticResource NotificationCardStyle}">
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#60FF6B6B" Offset="0"/>
                        <GradientStop Color="#30FF6B6B" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="BorderBrush" Value="#80FF6B6B"/>
        </Style>

        <!-- Info Notification Style -->
        <Style x:Key="InfoNotificationStyle" TargetType="Border" BasedOn="{StaticResource NotificationCardStyle}">
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#6000A6FB" Offset="0"/>
                        <GradientStop Color="#3000A6FB" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="BorderBrush" Value="#8000A6FB"/>
        </Style>

        <!-- Success Notification Style -->
        <Style x:Key="SuccessNotificationStyle" TargetType="Border" BasedOn="{StaticResource NotificationCardStyle}">
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#602FBF4C" Offset="0"/>
                        <GradientStop Color="#302FBF4C" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="BorderBrush" Value="#802FBF4C"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20">
        <StackPanel>
            <!-- Header -->
            <Border Style="{StaticResource GlassRoundedBorder}" Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="🔔 Admin Messages and Notifications" 
                               FontSize="28" 
                               FontWeight="Bold" 
                               Foreground="#00A6FB" 
                               Margin="0,0,0,10"/>

                    <TextBlock Text="Important announcements and updates from administration"
                               FontSize="14"
                               Foreground="#CCCCCC"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Border>


            <!-- Notifications List -->
            <StackPanel>
                <!-- Important System Notification -->
                <Border Style="{StaticResource ImportantNotificationStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="🚨 System Maintenance Tonight" 
                                       FontSize="18" 
                                       FontWeight="Bold" 
                                       Foreground="White" 
                                       Margin="0,0,0,8"/>

                            <TextBlock Text="All systems will be unavailable from 10:00 PM to 2:00 AM for scheduled maintenance. Please save your work and log out before this time."
                                       FontSize="13"
                                       Foreground="#CCCCCC"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,12"
                                       LineHeight="18"/>

                            <WrapPanel Orientation="Horizontal">
                                <StackPanel Orientation="Horizontal" Margin="0,0,20,0">
                                    <TextBlock Text="📅 Date:" 
                                               FontSize="12" 
                                               Foreground="#AAAAAA"
                                               Margin="0,0,5,0"/>
                                    <TextBlock Text="Jan 20, 2025 • 8:00 PM" 
                                               FontSize="12" 
                                               FontWeight="SemiBold" 
                                               Foreground="White"/>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="📢 From:" 
                                               FontSize="12" 
                                               Foreground="#AAAAAA"
                                               Margin="0,0,5,0"/>
                                    <TextBlock Text="IT Department" 
                                               FontSize="12" 
                                               FontWeight="SemiBold" 
                                               Foreground="White"/>
                                </StackPanel>
                            </WrapPanel>
                        </StackPanel>

                        <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                            <Border Style="{StaticResource StatusBadgeStyle}" Background="#80FF6B6B">
                                <TextBlock Text="⚠️ Active" 
                                           FontSize="11" 
                                           FontWeight="Bold" 
                                           Foreground="White"/>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Meeting Notification -->
                <Border Style="{StaticResource InfoNotificationStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="📅 Meeting Tomorrow at 10 AM" 
                                       FontSize="18" 
                                       FontWeight="Bold" 
                                       Foreground="White" 
                                       Margin="0,0,0,8"/>

                            <TextBlock Text="Quarterly performance review meeting in Conference Room A. Please bring your progress reports and be prepared to discuss Q1 goals."
                                       FontSize="13"
                                       Foreground="#CCCCCC"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,12"
                                       LineHeight="18"/>

                            <WrapPanel Orientation="Horizontal">
                                <StackPanel Orientation="Horizontal" Margin="0,0,20,0">
                                    <TextBlock Text="📅 Time:" 
                                               FontSize="12" 
                                               Foreground="#AAAAAA"
                                               Margin="0,0,5,0"/>
                                    <TextBlock Text="Jan 21, 2025 • 10:00 AM" 
                                               FontSize="12" 
                                               FontWeight="SemiBold" 
                                               Foreground="White"/>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="📍 Location:" 
                                               FontSize="12" 
                                               Foreground="#AAAAAA"
                                               Margin="0,0,5,0"/>
                                    <TextBlock Text="Conference Room A" 
                                               FontSize="12" 
                                               FontWeight="SemiBold" 
                                               Foreground="White"/>
                                </StackPanel>
                            </WrapPanel>
                        </StackPanel>

                        <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                            <Border Style="{StaticResource StatusBadgeStyle}" Background="#8000A6FB">
                                <TextBlock Text="📅 Upcoming" 
                                           FontSize="11" 
                                           FontWeight="Bold" 
                                           Foreground="White"/>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Policy Update -->
                <Border Style="{StaticResource InfoNotificationStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="📝 Updated Attendance Policy" 
                                       FontSize="18" 
                                       FontWeight="Bold" 
                                       Foreground="White" 
                                       Margin="0,0,0,8"/>

                            <TextBlock Text="Please review the updated attendance policy effective February 1st. Key changes include flexible working hours and new remote work guidelines."
                                       FontSize="13"
                                       Foreground="#CCCCCC"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,12"
                                       LineHeight="18"/>

                            <WrapPanel Orientation="Horizontal">
                                <StackPanel Orientation="Horizontal" Margin="0,0,20,0">
                                    <TextBlock Text="📅 Posted:" 
                                               FontSize="12" 
                                               Foreground="#AAAAAA"
                                               Margin="0,0,5,0"/>
                                    <TextBlock Text="Jan 18, 2025" 
                                               FontSize="12" 
                                               FontWeight="SemiBold" 
                                               Foreground="White"/>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="📢 From:" 
                                               FontSize="12" 
                                               Foreground="#AAAAAA"
                                               Margin="0,0,5,0"/>
                                    <TextBlock Text="HR Department" 
                                               FontSize="12" 
                                               FontWeight="SemiBold" 
                                               Foreground="White"/>
                                </StackPanel>
                            </WrapPanel>
                        </StackPanel>

                        <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                            <Border Style="{StaticResource StatusBadgeStyle}" Background="#8000A6FB">
                                <TextBlock Text="📋 Review Required" 
                                           FontSize="11" 
                                           FontWeight="Bold" 
                                           Foreground="White"/>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Holiday Notification -->
                <Border Style="{StaticResource SuccessNotificationStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="🎉 Company Holiday Announcement" 
                                       FontSize="18" 
                                       FontWeight="Bold" 
                                       Foreground="White" 
                                       Margin="0,0,0,8"/>

                            <TextBlock Text="The office will be closed on February 14th for Company Foundation Day. Regular operations will resume on February 17th. Wishing everyone a wonderful break!"
                                       FontSize="13"
                                       Foreground="#CCCCCC"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,12"
                                       LineHeight="18"/>

                            <WrapPanel Orientation="Horizontal">
                                <StackPanel Orientation="Horizontal" Margin="0,0,20,0">
                                    <TextBlock Text="🎊 Holiday:" 
                                               FontSize="12" 
                                               Foreground="#AAAAAA"
                                               Margin="0,0,5,0"/>
                                    <TextBlock Text="Feb 14, 2025" 
                                               FontSize="12" 
                                               FontWeight="SemiBold" 
                                               Foreground="White"/>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="📅 Return:" 
                                               FontSize="12" 
                                               Foreground="#AAAAAA"
                                               Margin="0,0,5,0"/>
                                    <TextBlock Text="Feb 17, 2025" 
                                               FontSize="12" 
                                               FontWeight="SemiBold" 
                                               Foreground="White"/>
                                </StackPanel>
                            </WrapPanel>
                        </StackPanel>

                        <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                            <Border Style="{StaticResource StatusBadgeStyle}" Background="#802FBF4C">
                                <TextBlock Text="✅ Confirmed" 
                                           FontSize="11" 
                                           FontWeight="Bold" 
                                           Foreground="White"/>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Training Session -->
                <Border Style="{StaticResource NotificationCardStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="🎯 Mandatory Training Session" 
                                       FontSize="18" 
                                       FontWeight="Bold" 
                                       Foreground="White" 
                                       Margin="0,0,0,8"/>

                            <TextBlock Text="Cybersecurity awareness training scheduled for all employees. This session is mandatory and will cover new security protocols."
                                       FontSize="13"
                                       Foreground="#CCCCCC"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,12"
                                       LineHeight="18"/>

                            <WrapPanel Orientation="Horizontal">
                                <StackPanel Orientation="Horizontal" Margin="0,0,20,0">
                                    <TextBlock Text="📅 Date:" 
                                               FontSize="12" 
                                               Foreground="#AAAAAA"
                                               Margin="0,0,5,0"/>
                                    <TextBlock Text="Jan 25, 2025 • 2:00 PM" 
                                               FontSize="12" 
                                               FontWeight="SemiBold" 
                                               Foreground="White"/>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="⏰ Duration:" 
                                               FontSize="12" 
                                               Foreground="#AAAAAA"
                                               Margin="0,0,5,0"/>
                                    <TextBlock Text="2 hours" 
                                               FontSize="12" 
                                               FontWeight="SemiBold" 
                                               Foreground="White"/>
                                </StackPanel>
                            </WrapPanel>
                        </StackPanel>

                        <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                            <Border Style="{StaticResource StatusBadgeStyle}" Background="#40FFFFFF">
                                <TextBlock Text="📚 Mandatory" 
                                           FontSize="11" 
                                           FontWeight="Bold" 
                                           Foreground="White"/>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>


        </StackPanel>
    </ScrollViewer>
</UserControl>