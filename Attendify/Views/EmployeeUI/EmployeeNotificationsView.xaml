<UserControl x:Class="Attendify.Views.UserControls.EmployeeNotificationsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1000"
             Background="Transparent">

    <UserControl.Resources>
        <!-- Glass container style -->
        <Style x:Key="GlassRoundedBorder" TargetType="Border">
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#33FFFFFF" Offset="0" />
                        <GradientStop Color="#13FFFFFF" Offset="1" />
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="BorderBrush" Value="#30FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="15"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="18" Opacity="0.18" ShadowDepth="2"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Default Notification Card Style -->
        <Style x:Key="NotificationCardStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#40FFFFFF" Offset="0"/>
                        <GradientStop Color="#20FFFFFF" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="BorderBrush" Value="#40FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Margin" Value="0,0,0,15"/>
        </Style>

        <!-- Status Badge Style -->
        <Style x:Key="StatusBadgeStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
        </Style>

        <!-- Important Notification Style -->
        <Style x:Key="ImportantNotificationStyle" TargetType="Border" BasedOn="{StaticResource NotificationCardStyle}">
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#60FF6B6B" Offset="0"/>
                        <GradientStop Color="#30FF6B6B" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="BorderBrush" Value="#80FF6B6B"/>
        </Style>

        <!-- Info Notification Style -->
        <Style x:Key="InfoNotificationStyle" TargetType="Border" BasedOn="{StaticResource NotificationCardStyle}">
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#6000A6FB" Offset="0"/>
                        <GradientStop Color="#3000A6FB" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="BorderBrush" Value="#8000A6FB"/>
        </Style>

        <!-- Success Notification Style -->
        <Style x:Key="SuccessNotificationStyle" TargetType="Border" BasedOn="{StaticResource NotificationCardStyle}">
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#602FBF4C" Offset="0"/>
                        <GradientStop Color="#302FBF4C" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="BorderBrush" Value="#802FBF4C"/>
        </Style>

        <!-- System Notification Style (uses Important style) -->
        <Style x:Key="SystemNotificationStyle" TargetType="Border" BasedOn="{StaticResource ImportantNotificationStyle}"/>

        <!-- Event Notification Style (uses Info style) -->
        <Style x:Key="EventNotificationStyle" TargetType="Border" BasedOn="{StaticResource InfoNotificationStyle}"/>

    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20">
        <StackPanel>
            <!-- Header -->
            <Border Style="{StaticResource GlassRoundedBorder}" Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="🔔 Admin Messages and Notifications" 
                               FontSize="28" 
                               FontWeight="Bold" 
                               Foreground="#00A6FB" 
                               Margin="0,0,0,10"/>

                    <TextBlock Text="Important announcements and updates from administration"
                               FontSize="14"
                               Foreground="#CCCCCC"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <!-- Dynamic Notifications List -->
            <StackPanel x:Name="NotificationsListPanel">
                <!-- Notifications will be loaded dynamically here -->
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</UserControl>