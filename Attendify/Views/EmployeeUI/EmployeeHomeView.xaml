<UserControl x:Class="Attendify.Views.Employee.EmployeeHomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="800"
             Background="Transparent">

    <UserControl.Resources>
        <!-- Modern Button Style -->
        <Style x:Key="ModernButton" TargetType="Button">
            <Setter Property="Background" Value="#38b000"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="15,10"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#0088CC"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#006699"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Secondary Button Style -->
        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource ModernButton}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#00A6FB"/>
            <Setter Property="BorderBrush" Value="#00A6FB"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <!-- Glass container style -->
        <ControlTemplate x:Key="GlassContainerTemplate" TargetType="ContentControl">
            <Grid>
                <Border x:Name="MainBorder" CornerRadius="10">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#33FFFFFF" Offset="0" />
                            <GradientStop Color="#13FFFFFF" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="18" Opacity="0.18" ShadowDepth="2"/>
                    </Border.Effect>
                </Border>
                <Border CornerRadius="10" Padding="12" Background="#22FFFFFF" BorderBrush="#40FFFFFF" BorderThickness="1">
                    <ContentPresenter />
                </Border>
            </Grid>
        </ControlTemplate>

        <!-- Stat Card Style -->
        <Style x:Key="StatCardStyle" TargetType="ContentControl">
            <Setter Property="Template" Value="{StaticResource GlassContainerTemplate}"/>
            <Setter Property="Margin" Value="10"/>
            <Setter Property="Height" Value="160"/>
        </Style>

        <!-- Status Badge Style -->
        <Style x:Key="StatusBadgeStyle" TargetType="Border">
            <Setter Property="Background" Value="#4000A6FB"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
        </Style>

        <!-- Message Item Style -->
        <Style x:Key="MessageItemStyle" TargetType="Border">
            <Setter Property="Background" Value="#20FFFFFF"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="15"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="10">
        <StackPanel>
            <!-- Welcome Section -->
            <ContentControl Template="{StaticResource GlassContainerTemplate}" Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="Welcome, Aman Baye" 
                              Foreground="#00A6FB" 
                               FontSize="24" 
                               FontWeight="Bold"
                               Margin="0,0,0,5"/>
                    <TextBlock Text="Here's your dashboard overview for today. Stay productive! 💪" 
                               Foreground="White" 
                               FontSize="14"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </ContentControl>

            <!-- Quick Stats Grid -->
            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Next Shift Card -->
                <ContentControl Grid.Column="0" Style="{StaticResource StatCardStyle}">
                    <StackPanel Margin="10">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <TextBlock Text="🕒" FontSize="16" VerticalAlignment="Center" Foreground="#00A6FB"  Margin="0,0,8,0"/>
                            <TextBlock Text="Next Shift" 
                                       Foreground="#00A6FB" 
                                       FontSize="16" 
                                       FontWeight="Bold"
                                       VerticalAlignment="Center"/>
                        </StackPanel>

                        <TextBlock Text="Morning Shift" 
                                   Foreground="White" 
                                   FontSize="18" 
                                   FontWeight="Bold"
                                   Margin="0,0,0,5"/>
                        <TextBlock Text="8:00 – 14:00" 
                                   Foreground="#CCCCCC" 
                                   FontSize="14"
                                   Margin="0,0,0,10"/>

                        <Border Style="{StaticResource StatusBadgeStyle}">
                            <TextBlock Text="Starts in 2 hours" 
                                       Foreground="White" 
                                       FontSize="11"
                                       FontWeight="SemiBold"/>
                        </Border>
                    </StackPanel>
                </ContentControl>

                <!-- Today's Attendance Card -->
                <ContentControl Grid.Column="1" Style="{StaticResource StatCardStyle}">
                    <StackPanel Margin="10">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <TextBlock Text="📊" FontSize="16" VerticalAlignment="Center" Foreground="#00A6FB"  Margin="0,0,8,0"/>
                            <TextBlock Text="Today's Attendance" 
                                       Foreground="#00A6FB"  
                                       FontSize="16" 
                                       FontWeight="Bold"
                                       VerticalAlignment="Center"/>
                        </StackPanel>

                        <TextBlock Text="Checked In: 9:03 AM" 
                                   Foreground="White" 
                                   FontSize="14" 
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,5"/>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                            <TextBlock Text="Status:" 
                                       Foreground="#CCCCCC" 
                                       FontSize="12"
                                       Margin="0,0,5,0"/>
                            <Border Background="#FF6B6B" CornerRadius="8" Padding="4,2">
                                <TextBlock Text="Late (3 min)" 
                                           Foreground="White" 
                                           FontSize="11"
                                           FontWeight="SemiBold"/>
                            </Border>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Grace:" 
                                       Foreground="#CCCCCC" 
                                       FontSize="12"
                                       Margin="0,0,5,0"/>
                            <TextBlock Text="5 min" 
                                       Foreground="#4CAF50" 
                                       FontSize="12"
                                       FontWeight="SemiBold"/>
                        </StackPanel>
                    </StackPanel>
                </ContentControl>

                <!-- Leave Status Card -->
                <ContentControl Grid.Column="2" Style="{StaticResource StatCardStyle}">
                    <StackPanel Margin="10">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <TextBlock Text="🏖️" FontSize="16" VerticalAlignment="Center" Foreground="#00A6FB"  Margin="0,0,8,0"/>
                            <TextBlock Text="Leave Status" 
Foreground="#00A6FB" 
                                       FontSize="16" 
                                       FontWeight="Bold"
                                       VerticalAlignment="Center"/>
                        </StackPanel>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                                <TextBlock Text="1" 
                                           Foreground="#FF9800" 
                                           FontSize="24" 
                                           FontWeight="Bold"
                                           HorizontalAlignment="Center"/>
                                <TextBlock Text="Pending" 
                                           Foreground="#CCCCCC" 
                                           FontSize="11"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                                <TextBlock Text="0" 
                                           Foreground="#4CAF50" 
                                           FontSize="24" 
                                           FontWeight="Bold"
                                           HorizontalAlignment="Center"/>
                                <TextBlock Text="Approved" 
                                           Foreground="#CCCCCC" 
                                           FontSize="11"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                                <TextBlock Text="0" 
                                           Foreground="#FF6B6B" 
                                           FontSize="24" 
                                           FontWeight="Bold"
                                           HorizontalAlignment="Center"/>
                                <TextBlock Text="Rejected" 
                                           Foreground="#CCCCCC" 
                                           FontSize="11"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Grid>

                        <Border Style="{StaticResource StatusBadgeStyle}">
                            <TextBlock Text="12 days remaining" 
                                       Foreground="White" 
                                       FontSize="11"
                                       FontWeight="SemiBold"/>
                        </Border>
                    </StackPanel>
                </ContentControl>
            </Grid>

          

            <!-- Recent Admin Messages -->
            <ContentControl Template="{StaticResource GlassContainerTemplate}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                        <TextBlock Text="📢 Recent Admin Messages" 
Foreground="#00A6FB" 
                                   FontSize="18" 
                                   FontWeight="Bold"
                                   VerticalAlignment="Center"/>
                        <Border Background="#4CAF50" CornerRadius="10" Padding="6,2" Margin="10,0,0,0">
                            <TextBlock Text="2 New" 
                                       Foreground="White" 
                                       FontSize="11"
                                       FontWeight="SemiBold"/>
                        </Border>
                    </StackPanel>

                    <StackPanel>
                        <!-- Message 1 -->
                        <Border Style="{StaticResource MessageItemStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="“System maintenance tonight”" 
                                               Foreground="White" 
                                               FontSize="14"
                                               FontWeight="SemiBold"
                                               Margin="0,0,0,5"/>
                                    <TextBlock Text="The system will be down for maintenance from 10 PM to 2 AM. Please save your work." 
                                               Foreground="#CCCCCC" 
                                               FontSize="12"
                                               TextWrapping="Wrap"/>
                                </StackPanel>

                                <Border Grid.Column="1" 
                                        Background="#4CAF50" 
                                        CornerRadius="8" 
                                        Padding="6,2"
                                        VerticalAlignment="Top"
                                        Margin="10,0,0,0">
                                    <TextBlock Text="Active" 
                                               Foreground="White" 
                                               FontSize="10"
                                               FontWeight="SemiBold"/>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- Message 2 -->
                        <Border Style="{StaticResource MessageItemStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="“Meeting on Monday 10 AM”" 
                                               Foreground="White" 
                                               FontSize="14"
                                               FontWeight="SemiBold"
                                               Margin="0,0,0,5"/>
                                    <TextBlock Text="Quarterly review meeting in Conference Room A. All employees must attend." 
                                               Foreground="#CCCCCC" 
                                               FontSize="12"
                                               TextWrapping="Wrap"/>
                                </StackPanel>

                                <Border Grid.Column="1" 
                                        Background="#FF9800" 
                                        CornerRadius="8" 
                                        Padding="6,2"
                                        VerticalAlignment="Top"
                                        Margin="10,0,0,0">
                                    <TextBlock Text="Important" 
                                               Foreground="White" 
                                               FontSize="10"
                                               FontWeight="SemiBold"/>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- Message 3 -->
                        <Border Style="{StaticResource MessageItemStyle}">
                            <StackPanel>
                                <TextBlock Text="“Holiday Schedule Update”" 
                                           Foreground="White" 
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           Margin="0,0,0,5"/>
                                <TextBlock Text="Office will be closed on December 25th for Christmas holiday." 
                                           Foreground="#CCCCCC" 
                                           FontSize="12"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </ContentControl>

            <!-- Recent Activity (Optional) -->
            <ContentControl Template="{StaticResource GlassContainerTemplate}" Margin="0,20,0,0">
                <StackPanel>
                    <TextBlock Text="Recent Activity" 
                               Foreground="#00A6FB" 
                               FontSize="18" 
                               FontWeight="Bold"
                               Margin="0,0,0,15"/>

                    <StackPanel>
                        <Border Style="{StaticResource MessageItemStyle}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="✅" FontSize="16" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <TextBlock Text="Clocked in today at 09:03 AM" 
                                           Foreground="White" 
                                           VerticalAlignment="Center"/>
                                <TextBlock Text="2 hours ago" 
                                           Foreground="#CCCCCC" 
                                           FontSize="12"
                                           VerticalAlignment="Center"
                                           Margin="20,0,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource MessageItemStyle}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📋" FontSize="16" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <TextBlock Text="Leave request submitted for Dec 25" 
                                           Foreground="White" 
                                           VerticalAlignment="Center"/>
                                <TextBlock Text="1 day ago" 
                                           Foreground="#CCCCCC" 
                                           FontSize="12"
                                           VerticalAlignment="Center"
                                           Margin="20,0,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource MessageItemStyle}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🔄" FontSize="16" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <TextBlock Text="Shift changed to Morning shift" 
                                           Foreground="White" 
                                           VerticalAlignment="Center"/>
                                <TextBlock Text="3 days ago" 
                                           Foreground="#CCCCCC" 
                                           FontSize="12"
                                           VerticalAlignment="Center"
                                           Margin="20,0,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </ContentControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>