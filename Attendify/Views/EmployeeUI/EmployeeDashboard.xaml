<Window x:Class="Attendify.Views.Employee.EmployeeDashboard"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Attendify.Views"
        xmlns:uc="clr-namespace:Attendify.Views.UserControls"
        Title="Employee Dashboard - Attendify"
        WindowStartupLocation="CenterScreen"
        Width="1300" Height="780"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        MinWidth="1000" MinHeight="650">

    <Window.Resources>
        <!-- Brushes -->
        <RadialGradientBrush x:Key="MainRadial" GradientOrigin="0.3,0.2" Center="0.5,0.5" RadiusX="1" RadiusY="1">
            <GradientStop Color="#035399" Offset="0"/>
            <GradientStop Color="#010D2A" Offset="1"/>
        </RadialGradientBrush>

        <SolidColorBrush x:Key="SidebarBrush" Color="#010D2A"/>
        <SolidColorBrush x:Key="AccentBlue" Color="#00A6FB"/>
        <SolidColorBrush x:Key="LightText" Color="#FFFFFF"/>

        <!-- Glass container style -->
        <ControlTemplate x:Key="GlassContainerTemplate" TargetType="ContentControl">
            <Grid>
                <!-- simulated frosted background -->
                <Border CornerRadius="10">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#33FFFFFF" Offset="0" />
                            <GradientStop Color="#13FFFFFF" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <Border.Effect>
                        <!-- soft shadow to give depth -->
                        <DropShadowEffect BlurRadius="18" Opacity="0.18" ShadowDepth="2"/>
                    </Border.Effect>
                </Border>

                <!-- foreground content (sharp) -->
                <Border CornerRadius="10" Padding="12" Background="#22FFFFFF" BorderBrush="#40FFFFFF" BorderThickness="1">
                    <ContentPresenter />
                </Border>
            </Grid>
        </ControlTemplate>

        <!-- Updated Sidebar button style with glass effect -->
        <Style x:Key="SidebarButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#D9EAFE"/>
            <Setter Property="Padding" Value="10 8"/>
            <Setter Property="Margin" Value="6 6"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <!-- Glass liquid background -->
                            <Border x:Name="GlassBg" CornerRadius="8" >
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#15FFFFFF" Offset="0"/>
                                        <GradientStop Color="#08FFFFFF" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Border.BorderBrush>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#40FFFFFF" Offset="0"/>
                                        <GradientStop Color="#20FFFFFF" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.BorderBrush>
                                <Border.BorderThickness>1</Border.BorderThickness>
                            </Border>

                            <!-- Content container that moves when pressed -->
                            <Border x:Name="ContentContainer" Margin="0,0,0,0">
                                <ContentPresenter Margin="8,0,6,0" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="GlassBg" Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#25FFFFFF" Offset="0"/>
                                            <GradientStop Color="#15FFFFFF" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="GlassBg" Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#35FFFFFF" Offset="0"/>
                                            <GradientStop Color="#25FFFFFF" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                                <!-- Move content to the right when pressed -->
                                <Setter TargetName="ContentContainer" Property="Margin" Value="4,0,0,0"/>
                                <Setter Property="FontWeight" Value="Bold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Employee profile button style -->
        <Style x:Key="EmployeeProfileButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#A6C6F5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="Transparent" CornerRadius="4" Padding="4,2">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#2000A6FB"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- CUSTOM TITLE BAR -->
        <uc:CustomTitleBar Title="Employee Dashboard" DockPanel.Dock="Top"/>

        <Grid>
        <!-- background radial -->
        <Border Background="{StaticResource MainRadial}" />

        <!-- decorative uploaded background, low opacity -->
        <Image Source="/Assets/Images/bb2.png"
               Opacity="0.20"
               Stretch="UniformToFill"
               IsHitTestVisible="False" />

        <!-- layout: sidebar | splitter | main -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260" x:Name="SidebarColumn"/>
                <ColumnDefinition Width="6"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- SIDEBAR -->
            <Border Grid.Column="0" Background="{StaticResource SidebarBrush}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Title -->
                    <StackPanel Orientation="Horizontal" Margin="18" VerticalAlignment="Top" Height="72">
                        <TextBlock Text="Attendify" Foreground="{StaticResource AccentBlue}" FontSize="30" FontWeight="Bold" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Buttons area with sliding indicator -->
                    <Grid Grid.Row="1" Margin="8,8,8,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="8"/>
                            <!-- indicator column -->
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- indicator -->
                        <Border x:Name="SideIndicator" Grid.Column="0" Background="{StaticResource AccentBlue}"
                                 Width="8" Height="40" VerticalAlignment="Top" Margin="3,2,0,0" Grid.ColumnSpan="2" HorizontalAlignment="Left">
                            <Border.RenderTransform>
                                <TranslateTransform x:Name="IndicatorTransform" Y="0" />
                            </Border.RenderTransform>
                        </Border>

                        <StackPanel Grid.Column="1" x:Name="SidebarButtonsPanel" >
                            <Button x:Name="BtnHome" Style="{StaticResource SidebarButton}" Click="BtnHome_Click" Height="40">
                                <StackPanel Orientation="Horizontal" >
                                    <TextBlock Text="🏠" FontSize="20" Margin="0,0,8,0"/>
                                    <TextBlock Text="Home" FontSize="20"/>
                                </StackPanel>
                            </Button>

                            <Button x:Name="BtnAttendance" Style="{StaticResource SidebarButton}" Click="BtnAttendance_Click" Height="40">
                                <StackPanel Orientation="Horizontal" >
                                    <TextBlock Text="📊" FontSize="20" Margin="0,0,8,0"/>
                                    <TextBlock Text="Attendance" FontSize="20"/>
                                </StackPanel>
                            </Button>

                            <Button x:Name="BtnLeaveRequests" Style="{StaticResource SidebarButton}" Click="BtnLeaveRequests_Click" Height="40">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="📋" FontSize="20" Margin="0,0,8,0"/>
                                    <TextBlock Text="Leave Requests" FontSize="20"/>
                                </StackPanel>
                            </Button>

                            <Button x:Name="BtnShifts" Style="{StaticResource SidebarButton}" Click="BtnShifts_Click" Height="40" >
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🕒" FontSize="20" Margin="0,0,8,0"/>
                                    <TextBlock Text="My Shifts" FontSize="20"/>
                                </StackPanel>
                            </Button>

                            <Button x:Name="BtnReports" Style="{StaticResource SidebarButton}" Click="BtnReports_Click" Height="40" >
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="📈" FontSize="20" Margin="0,0,8,0"/>
                                    <TextBlock Text="My Reports" FontSize="20"/>
                                </StackPanel>
                            </Button>

                            <Button x:Name="BtnNotifications" Style="{StaticResource SidebarButton}" Click="BtnNotifications_Click" Height="40" >
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🔔" FontSize="20" Margin="0,0,8,0"/>
                                    <TextBlock Text="Notifications" FontSize="20"/>
                                </StackPanel>
                            </Button>

                            <!-- Contact Admin Button -->
                            <Button x:Name="BtnContactAdmin" 
                                    Style="{StaticResource SidebarButton}"
                                    Height="40"
                                    
                                    Click="BtnContactAdmin_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📧" 
                                    FontSize="20" 
                                    VerticalAlignment="Center"
                                    Margin="0,0,5,0"/>
                                    <TextBlock Text="Contact Admin" 
                                    FontSize="20" 
                                    VerticalAlignment="Center"/>
                            </StackPanel>
                            </Button>

                        </StackPanel>
                    </Grid>

                    <!-- bottom: profile initial + name and account button -->
                    <Border Grid.Row="2" Padding="14" Background="Transparent">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
                            <Border Width="44" Height="44" CornerRadius="22" Background="#00A6FB" VerticalAlignment="Center">
                                <TextBlock x:Name="ProfileInitial" Text="E" Foreground="White" FontWeight="Bold" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>

                            <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock x:Name="ProfileName" Text="John Doe" Foreground="White" FontWeight="Bold"/>
                                <Button x:Name="AccountBtn" Content="Employee ▾" Style="{StaticResource EmployeeProfileButton}" Click="AccountBtn_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- GridSplitter to allow user-moving sidebar -->
            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" Background="#01243A" ShowsPreview="True"/>

            <!-- MAIN AREA -->
            <Border Grid.Column="2" Padding="20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Improved Glass Header -->
                    <Border Grid.Row="0" Margin="0,0,0,15" CornerRadius="12" Background="#20FFFFFF" BorderBrush="#30FFFFFF" BorderThickness="1" Padding="20,15">
                        <Grid>
                            <StackPanel HorizontalAlignment="Left" VerticalAlignment="Center">
                                <TextBlock Text="EMPLOYEE DASHBOARD" 
                                           FontSize="12" 
                                           FontWeight="SemiBold" 
                                           Foreground="#00A6FB"/>
                                <TextBlock x:Name="PageTitle" 
                                           Text="{Binding CurrentPageTitle}" 
                                           FontSize="28" 
                                           FontWeight="Bold"
                                           Foreground="White" 
                                           Margin="0,2,0,0"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <StackPanel Margin="0,0,30,0">
                                    <TextBlock Text="CURRENT DATE" FontSize="10" Foreground="#80FFFFFF" HorizontalAlignment="Right"/>
                                    <TextBlock x:Name="DateText" 
                                               Text="{Binding CurrentDate}" 
                                               Foreground="White" 
                                               FontSize="16" 
                                               FontWeight="SemiBold"/>
                                </StackPanel>
                                <StackPanel Margin="0,0,30,0">
                                    <TextBlock Text="SHIFT" FontSize="10" Foreground="#80FFFFFF" HorizontalAlignment="Right"/>
                                    <TextBlock x:Name="ShiftText" 
                                               Text="{Binding CurrentShift}" 
                                               Foreground="White" 
                                               FontSize="16" 
                                               FontWeight="SemiBold"/>
                                </StackPanel>
                                <Border Background="#40000000" CornerRadius="8" Padding="15,8">
                                    <StackPanel>
                                        <TextBlock Text="ATTENDANCE TIME" FontSize="10" Foreground="#80FFFFFF" HorizontalAlignment="Center"/>
                                        <TextBlock x:Name="ClockText" 
                                                   Text="{Binding CurrentTime}" 
                                                   Foreground="#00A6FB" 
                                                   FontSize="20" 
                                                   FontWeight="Bold"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Dynamic Content Area -->
                    <ContentControl x:Name="MainContentControl" 
                                    Grid.Row="1" 
                                    Content="{Binding CurrentView}"/>
                </Grid>
            </Border>
        </Grid>

        <!-- LOADING OVERLAY -->
        <views:LoadingOverlay x:Name="EmployeeLoadingOverlay"
                               Visibility="Collapsed"
                               Grid.ZIndex="1000"/>
        </Grid>
    </DockPanel>
</Window>