<UserControl x:Class="Attendify.Views.Employee.EmployeeLeaveRequestsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Attendify.Views.Employee"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="900"
             Background="Transparent">

    <UserControl.Resources>
        <!-- Glass container style -->
        <ControlTemplate x:Key="GlassContainerTemplate" TargetType="ContentControl">
            <Grid>
                <Border CornerRadius="10">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#03FFFFFF" Offset="0" />
                            <GradientStop Color="#01FFFFFF" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="18" Opacity="0.18" ShadowDepth="2"/>
                    </Border.Effect>
                </Border>
                <Border CornerRadius="10" Padding="12" Background="#22FFFFFF" BorderBrush="#40FFFFFF" BorderThickness="1">
                    <ContentPresenter />
                </Border>
            </Grid>
        </ControlTemplate>

        <!-- Modern Button Style -->
        <Style x:Key="ModernButton" TargetType="Button">
            <Setter Property="Background" Value="#00A6FB"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#0088CC"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#006699"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="#CCCCCC"/>
                                <Setter Property="Foreground" Value="#666666"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Secondary Button Style -->
        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource ModernButton}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#00A6FB"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <!-- Small Action Button Style -->
        <Style x:Key="SmallActionButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="2"/>
        </Style>

        <!-- DataGrid Style -->
        <Style x:Key="ModernDataGrid" TargetType="DataGrid">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="GridLinesVisibility" Value="None"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
            <Setter Property="ScrollViewer.PanningMode" Value="Both"/>
            <Setter Property="Stylus.IsFlicksEnabled" Value="False"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="SelectionUnit" Value="FullRow"/>
        </Style>

        <!-- DataGridRow Style -->
        <Style x:Key="DataGridRowStyle" TargetType="DataGridRow">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#2000A6FB"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#4000A6FB"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- TextBox Style -->
        <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="#20FFFFFF"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#40FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Grid>
                            <Border x:Name="border" 
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="8">
                                <ScrollViewer x:Name="PART_ContentHost"
                                              VerticalAlignment="Center"
                                              Background="Transparent"/>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#00A6FB"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- BooleanToVisibility Converter -->
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>

    </UserControl.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header Section -->
        <ContentControl Grid.Row="0" Template="{StaticResource GlassContainerTemplate}" Margin="0,0,0,15">
            <StackPanel>
                <TextBlock Text="Leave Requests" 
                           Foreground="#00A6FB" 
                           FontSize="24" 
                           FontWeight="Bold"
                           Margin="0,0,0,5"/>
                <TextBlock Text="Request time off and track your leave applications" 
                           Foreground="White" 
                           FontSize="14"
                           TextWrapping="Wrap"/>
            </StackPanel>
        </ContentControl>

        <!-- Main Content Area -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="7*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="3*"/>
            </Grid.ColumnDefinitions>

            <!-- Leave History Section -->
            <ContentControl Grid.Column="0" Template="{StaticResource GlassContainerTemplate}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Quick Stats -->
                    <Grid Grid.Row="0" Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Pending Requests -->
                        <ContentControl Grid.Column="0" Template="{StaticResource GlassContainerTemplate}" Margin="5">
                            <StackPanel Margin="10" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="⏳ Pending" 
                                           Foreground="#00A6FB" 
                                           FontSize="14" 
                                           FontWeight="Bold"
                                           HorizontalAlignment="Center"
                                           Margin="0,0,0,5"/>
                                <TextBlock x:Name="PendingCount" 
                                           Text="0" 
                                           Foreground="#FF9800" 
                                           FontSize="24" 
                                           FontWeight="Bold"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>
                        </ContentControl>

                        <!-- Approved Requests -->
                        <ContentControl Grid.Column="1" Template="{StaticResource GlassContainerTemplate}" Margin="5">
                            <StackPanel Margin="10" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="✅ Approved" 
                                           Foreground="#00A6FB" 
                                           FontSize="14" 
                                           FontWeight="Bold"
                                           HorizontalAlignment="Center"
                                           Margin="0,0,0,5"/>
                                <TextBlock x:Name="ApprovedCount" 
                                           Text="0" 
                                           Foreground="#38b000" 
                                           FontSize="24" 
                                           FontWeight="Bold"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>
                        </ContentControl>

                        <!-- Rejected Requests -->
                        <ContentControl Grid.Column="2" Template="{StaticResource GlassContainerTemplate}" Margin="5">
                            <StackPanel Margin="10" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="❌ Rejected" 
                                           Foreground="#00A6FB" 
                                           FontSize="14" 
                                           FontWeight="Bold"
                                           HorizontalAlignment="Center"
                                           Margin="0,0,0,5"/>
                                <TextBlock x:Name="RejectedCount" 
                                           Text="0" 
                                           Foreground="#FF6B6B" 
                                           FontSize="24" 
                                           FontWeight="Bold"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>
                        </ContentControl>
                    </Grid>

                    <!-- Request Button -->
                    <Border Grid.Row="1" 
                            Background="#20FFFFFF" 
                            CornerRadius="8" 
                            BorderBrush="#40FFFFFF" 
                            BorderThickness="1" 
                            Margin="0,0,0,15"
                            Height="40">
                        <Button Content="+ Request Leave" 
                                Style="{StaticResource ModernButton}"
                                HorizontalAlignment="Right"
                                Margin="5"
                                Padding="20,0"
                                Click="RequestLeave_Click"/>
                    </Border>

                    <!-- Leave History Table -->
                    <DataGrid Grid.Row="2"
                              x:Name="LeaveHistoryGrid"
                              Style="{StaticResource ModernDataGrid}"
                              RowStyle="{StaticResource DataGridRowStyle}"
                              AutoGenerateColumns="False"
                              SelectionChanged="LeaveHistoryGrid_SelectionChanged">

                        <DataGrid.Columns>
                            <DataGridTextColumn Header="From" Binding="{Binding FromDate}" Width="100">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn Header="To" Binding="{Binding ToDate}" Width="100">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn Header="Reason" Binding="{Binding ReasonTitle}" Width="*"/>

                            <DataGridTemplateColumn Header="Status" Width="120">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Background="{Binding StatusColor}" 
                                                CornerRadius="10" 
                                                Padding="8,4"
                                                HorizontalAlignment="Center">
                                            <TextBlock Text="{Binding Status}" 
                                                       Foreground="White" 
                                                       FontWeight="SemiBold"
                                                       FontSize="11"
                                                       HorizontalAlignment="Center"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="Actions" Width="120">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="View" 
                                                    Style="{StaticResource SmallActionButton}"
                                                    Click="ViewDetails_Click"
                                                    Tag="{Binding}"/>
                                            <Button x:Name="BtnCancel" 
                                                    Content="Cancel" 
                                                    Style="{StaticResource SmallActionButton}"
                                                    Click="CancelRequest_Click"
                                                    Tag="{Binding}"
                                                    Visibility="{Binding CanCancel, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>

                        <DataGrid.CellStyle>
                            <Style TargetType="DataGridCell">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Padding" Value="10,8"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="DataGridCell">
                                            <Border Background="Transparent" Padding="10,8">
                                                <ContentPresenter VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </DataGrid.CellStyle>

                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Foreground" Value="#00A6FB"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Padding" Value="10,12"/>
                                <Setter Property="HorizontalContentAlignment" Value="Left"/>
                            </Style>
                        </DataGrid.ColumnHeaderStyle>
                    </DataGrid>
                </Grid>
            </ContentControl>

            <!-- Leave Form Section -->
            <ContentControl Grid.Column="2" 
                            Template="{StaticResource GlassContainerTemplate}"
                            x:Name="LeaveFormContainer">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="10">
                        <!-- Form Title -->
                        <TextBlock x:Name="FormTitle" 
                                   Text="Leave Request Form" 
                                   Foreground="#00A6FB" 
                                   FontSize="18" 
                                   FontWeight="Bold"
                                   Margin="0,0,0,15"/>

                        <!-- Leave Request Form -->
                        <StackPanel x:Name="LeaveRequestForm" Visibility="Visible">
                            <!-- From Date -->
                            <TextBlock Text="From Date *" 
                                       Foreground="White" 
                                       FontWeight="SemiBold"
                                       Margin="0,5,0,2"/>
                            <DatePicker x:Name="DatePickerFrom"
                                        Background="#20FFFFFF"
                                        Foreground="Black"
                                        BorderBrush="#40FFFFFF"
                                        BorderThickness="1"
                                        Padding="8"
                                        Height="35"/>

                            <!-- To Date -->
                            <TextBlock Text="To Date *" 
                                       Foreground="White" 
                                       FontWeight="SemiBold"
                                       Margin="0,10,0,2"/>
                            <DatePicker x:Name="DatePickerTo"
                                        Background="#20FFFFFF"
                                        Foreground="Black"
                                        BorderBrush="#40FFFFFF"
                                        BorderThickness="1"
                                        Padding="8"
                                        Height="35"/>

                            <!-- Reason Title -->
                            <TextBlock Text="Reason Title *" 
                                       Foreground="White" 
                                       FontWeight="SemiBold"
                                       Margin="0,10,0,2"/>
                            <TextBox x:Name="TxtReasonTitle" 
                                     Style="{StaticResource ModernTextBox}"/>

                            <!-- Detailed Reason -->
                            <TextBlock Text="Detailed Reason" 
                                       Foreground="White" 
                                       FontWeight="SemiBold"
                                       Margin="0,10,0,2"/>
                            <TextBox x:Name="TxtDetailedReason"
                                     Style="{StaticResource ModernTextBox}"
                                     Height="100"
                                     TextWrapping="Wrap"
                                     AcceptsReturn="True"
                                     VerticalScrollBarVisibility="Auto"/>

                            <!-- Form Buttons -->
                            <StackPanel x:Name="NewRequestButtons" 
                                        Orientation="Horizontal" 
                                        HorizontalAlignment="Stretch" 
                                        Margin="0,20,0,0">
                                <Button x:Name="BtnSubmitRequest" 
                                        Content="Submit Request" 
                                        Style="{StaticResource ModernButton}"
                                        Margin="0,0,10,0"
                                        Height="35"
                                        Click="SubmitRequest_Click"/>
                                <Button x:Name="BtnCancelRequest" 
                                        Content="Cancel" 
                                        Style="{StaticResource SecondaryButton}"
                                        Height="35"
                                        Click="CancelNewRequest_Click"/>
                            </StackPanel>

                            <!-- Required fields note -->
                            <TextBlock Text="* Required fields" 
                                       Foreground="#888888" 
                                       FontSize="11"
                                       Margin="0,10,0,0"
                                       FontStyle="Italic"/>
                        </StackPanel>

                        <!-- View Details Form -->
                        <StackPanel x:Name="ViewDetailsForm" Visibility="Collapsed">
                            <!-- From Date -->
                            <TextBlock Text="From Date" 
                                       Foreground="#CCCCCC" 
                                       FontWeight="SemiBold"
                                       Margin="0,5,0,2"/>
                            <TextBlock x:Name="DetailFromDate"
                                       Foreground="White" 
                                       Margin="0,0,0,10"/>

                            <!-- To Date -->
                            <TextBlock Text="To Date" 
                                       Foreground="#CCCCCC" 
                                       FontWeight="SemiBold"
                                       Margin="0,5,0,2"/>
                            <TextBlock x:Name="DetailToDate"
                                       Foreground="White" 
                                       Margin="0,0,0,10"/>

                            <!-- Reason Title -->
                            <TextBlock Text="Reason" 
                                       Foreground="#CCCCCC" 
                                       FontWeight="SemiBold"
                                       Margin="0,5,0,2"/>
                            <TextBlock x:Name="DetailReasonTitle"
                                       Foreground="White" 
                                       Margin="0,0,0,10"/>

                            <!-- Detailed Reason -->
                            <TextBlock Text="Detailed Reason" 
                                       Foreground="#CCCCCC" 
                                       FontWeight="SemiBold"
                                       Margin="0,5,0,2"/>
                            <TextBlock x:Name="DetailDetailedReason"
                                       Foreground="White" 
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,10"/>

                            <!-- Status -->
                            <TextBlock Text="Status" 
                                       Foreground="#CCCCCC" 
                                       FontWeight="SemiBold"
                                       Margin="0,5,0,2"/>
                            <TextBlock x:Name="DetailStatus"
                                       Foreground="White" 
                                       Margin="0,0,0,10"/>

                            <!-- Admin Response -->
                            <TextBlock Text="Admin Response" 
                                       Foreground="#CCCCCC" 
                                       FontWeight="SemiBold"
                                       Margin="0,5,0,2"/>
                            <TextBlock x:Name="DetailAdminResponse"
                                       Foreground="White" 
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,10"/>

                            <!-- Created At -->
                            <TextBlock Text="Submitted On" 
                                       Foreground="#CCCCCC" 
                                       FontWeight="SemiBold"
                                       Margin="0,5,0,2"/>
                            <TextBlock x:Name="DetailCreatedAt"
                                       Foreground="White" 
                                       Margin="0,0,0,10"/>

                            <!-- Close Button -->
                            <Button Content="Close" 
                                    Style="{StaticResource ModernButton}"
                                    HorizontalAlignment="Center"
                                    Margin="0,20,0,0"
                                    Padding="20,8"
                                    Click="CloseDetails_Click"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </ContentControl>
        </Grid>
    </Grid>
</UserControl>