<UserControl x:Class="Attendify.Views.UserControls.EmployeeReportsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1000"
             Background="Transparent">

    <UserControl.Resources>
        <!-- Loading Spinner Style -->
        <Style x:Key="LoadingSpinnerStyle" TargetType="Control">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate>
                        <Viewbox Width="24" Height="24">
                            <Grid>
                                <Ellipse Stroke="#00A6FB" StrokeThickness="3" Opacity="0.3"/>
                                <Path Data="M1,0.5 A0.5,0.5 0 0,1 0.5,1" Stroke="#00A6FB" StrokeThickness="3">
                                    <Path.RenderTransform>
                                        <RotateTransform Angle="0" CenterX="0.5" CenterY="0.5"/>
                                    </Path.RenderTransform>
                                    <Path.Triggers>
                                        <EventTrigger RoutedEvent="Loaded">
                                            <BeginStoryboard>
                                                <Storyboard RepeatBehavior="Forever">
                                                    <DoubleAnimation Storyboard.TargetProperty="(Path.RenderTransform).(RotateTransform.Angle)"
                                                                     From="0" To="360" Duration="0:0:1"/>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>
                                    </Path.Triggers>
                                </Path>
                            </Grid>
                        </Viewbox>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Glass container style -->
        <Style x:Key="GlassRoundedBorder" TargetType="Border">
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#10FFFFFF" Offset="0" />
                        <GradientStop Color="#10FFFFFF" Offset="1" />
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="BorderBrush" Value="#30FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="15"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="18" Opacity="0.18" ShadowDepth="2"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- KPI Card Style -->
        <Style x:Key="KpiCardStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#10FFFFFF" Offset="0"/>
                        <GradientStop Color="#10FFFFFF" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="BorderBrush" Value="#60FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Width" Value="150"/>
            <Setter Property="Height" Value="90"/>
            <Setter Property="Margin" Value="8"/>
            <Setter Property="Padding" Value="15"/>
        </Style>

        <!-- DataGrid Style -->
        <Style x:Key="ModernDataGrid" TargetType="DataGrid">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#40FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="RowBackground" Value="Transparent"/>
            <Setter Property="AlternatingRowBackground" Value="#10FFFFFF"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="CanUserReorderColumns" Value="False"/>
            <Setter Property="CanUserResizeRows" Value="False"/>
            <Setter Property="CanUserSortColumns" Value="True"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#20FFFFFF"/>
            <Setter Property="VerticalGridLinesBrush" Value="Transparent"/>
            <Setter Property="RowHeight" Value="35"/>
        </Style>

        <Style x:Key="DataGridColumnHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#2000A6FB"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#40FFFFFF"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="10,5"/>
        </Style>

        <Style x:Key="DataGridTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Padding" Value="10,5"/>
        </Style>

        <!-- BooleanToVisibility Converter -->
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>

    </UserControl.Resources>

    <Grid>
        <!-- Main Content -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20">
            <StackPanel>
                <!-- Header -->
                <TextBlock Text="📊 My Attendance Report" 
                           FontSize="28" 
                           FontWeight="Bold" 
                           Foreground="#00A6FB" 
                           Margin="0,0,0,20"/>

                <TextBlock Text="View your attendance statistics and monthly performance reports"
                           FontSize="14"
                           Foreground="#CCCCCC"
                           Margin="0,0,0,25"
                           TextWrapping="Wrap"/>

                <!-- KPI Cards - Data Bound -->
                <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,25">
                    <!-- Attendance Percentage -->
                    <Border Style="{StaticResource KpiCardStyle}">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="AttendanceRateText"
                                       Text="{Binding AttendanceRate, FallbackValue=85%}" 
                                       FontSize="24" 
                                       FontWeight="Bold" 
                                       Foreground="#00A6FB" 
                                       HorizontalAlignment="Center"/>
                            <TextBlock Text="Attendance Rate" 
                                       FontSize="11" 
                                       Foreground="White" 
                                       HorizontalAlignment="Center"
                                       TextWrapping="Wrap"
                                       TextAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Days Present -->
                    <Border Style="{StaticResource KpiCardStyle}">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="DaysPresentText"
                                       Text="{Binding DaysPresent, FallbackValue=18}" 
                                       FontSize="24" 
                                       FontWeight="Bold" 
                                       Foreground="#2FBF4C" 
                                       HorizontalAlignment="Center"/>
                            <TextBlock Text="Days Present" 
                                       FontSize="11" 
                                       Foreground="White" 
                                       HorizontalAlignment="Center"
                                       TextWrapping="Wrap"
                                       TextAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Late Arrivals -->
                    <Border Style="{StaticResource KpiCardStyle}">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="LateArrivalsText"
                                       Text="{Binding LateArrivals, FallbackValue=6}" 
                                       FontSize="24" 
                                       FontWeight="Bold" 
                                       Foreground="#E3C63A" 
                                       HorizontalAlignment="Center"/>
                            <TextBlock Text="Late Arrivals" 
                                       FontSize="11" 
                                       Foreground="White" 
                                       HorizontalAlignment="Center"
                                       TextWrapping="Wrap"
                                       TextAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Days Absent -->
                    <Border Style="{StaticResource KpiCardStyle}">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="DaysAbsentText"
                                       Text="{Binding DaysAbsent, FallbackValue=2}" 
                                       FontSize="24" 
                                       FontWeight="Bold" 
                                       Foreground="#D23C3C" 
                                       HorizontalAlignment="Center"/>
                            <TextBlock Text="Days Absent" 
                                       FontSize="11" 
                                       Foreground="White" 
                                       HorizontalAlignment="Center"
                                       TextWrapping="Wrap"
                                       TextAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Leaves Used -->
                    <Border Style="{StaticResource KpiCardStyle}">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="LeavesUsedText"
                                       Text="{Binding LeavesUsed, FallbackValue=3}" 
                                       FontSize="24" 
                                       FontWeight="Bold" 
                                       Foreground="#A95315" 
                                       HorizontalAlignment="Center"/>
                            <TextBlock Text="Leaves Used" 
                                       FontSize="11" 
                                       Foreground="White" 
                                       HorizontalAlignment="Center"
                                       TextWrapping="Wrap"
                                       TextAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </WrapPanel>

                <!-- Detailed Report Table -->
                <Border Style="{StaticResource GlassRoundedBorder}" Margin="0,0,0,20">
                    <StackPanel>
                        <TextBlock Text="📋 Monthly Performance Report (Last 6 Months)" 
                                   FontSize="16" 
                                   FontWeight="Bold" 
                                   Foreground="White" 
                                   Margin="0,0,0,15"/>

                        <DataGrid x:Name="MonthlyReportGrid" 
                                  Style="{StaticResource ModernDataGrid}"
                                  ColumnHeaderStyle="{StaticResource DataGridColumnHeaderStyle}"
                                  Height="300"
                                  ItemsSource="{Binding MonthlyReports}"
                                  AutoGenerateColumns="False">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Month" 
                                                    Binding="{Binding Month}" 
                                                    Width="*"
                                                    ElementStyle="{StaticResource DataGridTextStyle}"/>
                                <DataGridTextColumn Header="Present" 
                                                    Binding="{Binding Present}" 
                                                    Width="*"
                                                    ElementStyle="{StaticResource DataGridTextStyle}"/>
                                <DataGridTextColumn Header="Late" 
                                                    Binding="{Binding Late}" 
                                                    Width="*"
                                                    ElementStyle="{StaticResource DataGridTextStyle}"/>
                                <DataGridTextColumn Header="Absent" 
                                                    Binding="{Binding Absent}" 
                                                    Width="*"
                                                    ElementStyle="{StaticResource DataGridTextStyle}"/>
                                <DataGridTextColumn Header="Leaves Approved" 
                                                    Binding="{Binding LeavesApproved}" 
                                                    Width="*"
                                                    ElementStyle="{StaticResource DataGridTextStyle}"/>
                                <DataGridTextColumn Header="Attendance %" 
                                                    Binding="{Binding AttendancePercentage, StringFormat={}{0}%}" 
                                                    Width="*"
                                                    ElementStyle="{StaticResource DataGridTextStyle}"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>

        
            </StackPanel>
        </ScrollViewer>

        <!-- Loading Overlay -->
        <Border x:Name="LoadingOverlay" 
                Background="#80000000"
                VerticalAlignment="Stretch"
                HorizontalAlignment="Stretch"
                Visibility="Collapsed"
                Panel.ZIndex="1000">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <Control Style="{StaticResource LoadingSpinnerStyle}" Width="40" Height="40"/>
                <TextBlock Text="Loading report data..." 
                           Foreground="White" 
                           FontSize="16" 
                           FontWeight="Bold"
                           Margin="0,10,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>