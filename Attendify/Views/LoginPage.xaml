<Window x:Class="Attendify.LoginPage"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Attendify.Views"
        Title="Login"
        WindowStartupLocation="CenterScreen"
        Width="1200" Height="700"
        ResizeMode="NoResize"
        WindowStyle="None"
        KeyDown="Window_KeyDown">
    <Window.InputBindings>
        <KeyBinding Key="Enter" Command="{Binding LoginCommand}"/>
    </Window.InputBindings>
    <Window.Resources>
        <BlurEffect x:Key="blurEffect" Radius="12"/>
    </Window.Resources>

    <Grid>
        <!-- Background Image -->
        <Image Source="/Assets/Images/login.png" Stretch="Fill"/>

        <!-- Logo -->
        <StackPanel Orientation="Horizontal" Margin="40,25,0,0" VerticalAlignment="Top">
            <TextBlock Text="Attendify"
                       VerticalAlignment="Center"
                       Margin="10,0,0,0"
                       FontSize="26"
                       FontWeight="Bold"
                       Foreground="#00A6FB"/>
        </StackPanel>

        <!-- TOP RIGHT CLOSE BUTTON -->
        <Button x:Name="CloseButton"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Margin="0,20,20,0"
                Width="40" Height="40"
                Background="Transparent"
                BorderThickness="0"
                Foreground="White"
                FontSize="24"
                Content="×"
                Cursor="Hand"
                Click="CloseButton_Click">
            <Button.Style>
                <Style TargetType="Button">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="20">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#AAFF4444"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Button.Style>
        </Button>

        <!-- CENTER CARD -->
        <Grid HorizontalAlignment="Center"
              VerticalAlignment="Center"
              Width="350">

            <!-- BLUR LAYER ONLY -->
            <Border CornerRadius="35"
                    Background="#20FFFFFF"
                    Effect="{StaticResource blurEffect}"/>

            <!-- CONTENT LAYER (CLEAR) -->
            <Border CornerRadius="35"
                    Padding="40"
                    Background="#10FFFFFF">

                <StackPanel>

                    <TextBlock Text="Welcome back!"
                               FontSize="32"
                               FontWeight="Bold"
                               Foreground="White"
                               HorizontalAlignment="Center"
                               Margin="0 0 0 35"/>

                    <!-- EMAIL (Changed from Username) -->
                    <Border Background="#90FFFFFF"
                            CornerRadius="12"
                            Height="40"
                            Margin="0 0 0 15">
                        <Grid>
                            <TextBox x:Name="UsernameBox"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Foreground="Black"
                                     FontSize="14"
                                     Padding="7,8"
                                     TextChanged="UsernameBox_TextChanged"/>

                            <TextBlock x:Name="UserPlaceholder"
                                       Text="Email"
                                       Foreground="#555"
                                       Margin="10,10,0,0"
                                       IsHitTestVisible="False"/>
                        </Grid>
                    </Border>

                    <!-- PASSWORD -->
                    <Border Background="#90FFFFFF"
                            CornerRadius="12"
                            Height="40"
                            Margin="0 0 0 25">
                        <Grid>
                            <PasswordBox x:Name="PasswordBox"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         FontSize="14"
                                         Padding="7,8,35,8"
                                         PasswordChanged="PasswordBox_PasswordChanged"/>

                            <TextBox x:Name="PasswordRevealBox"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     FontSize="14"
                                     Padding="7,8,35,8"
                                     Visibility="Collapsed"
                                     TextChanged="PasswordRevealBox_TextChanged"/>

                            <TextBlock x:Name="PassPlaceholder"
                                       Text="Password"
                                       Foreground="#555"
                                       Margin="10,10,0,0"
                                       IsHitTestVisible="False"/>

                            <!-- Password Toggle Button -->
                            <!-- Password Toggle Button -->
                            <Button x:Name="TogglePasswordBtn"
                                    HorizontalAlignment="Right"
                                    Width="30"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Margin="0,0,5,0"
                                    Cursor="Hand"
                                    Click="TogglePassword_Click">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="Transparent">
                                                        <ContentPresenter />
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </Button.Style>
                                <Path x:Name="EyeIcon"
                                      Data="M12,4.5C7,4.5 2.73,7.61 1,12C2.73,16.39 7,19.5 12,19.5C17,19.5 21.27,16.39 23,12C21.27,7.61 17,4.5 12,4.5M12,17.5C8.96,17.5 6.5,15.04 6.5,12C6.5,8.96 8.96,6.5 12,6.5C15.04,6.5 17.5,8.96 17.5,12C17.5,15.04 15.04,17.5 12,17.5M12,8.5C10.07,8.5 8.5,10.07 8.5,12C8.5,13.93 10.07,15.5 12,15.5C13.93,15.5 15.5,13.93 15.5,12C15.5,10.07 13.93,8.5 12,8.5Z"
                                      Fill="#555"
                                      Stretch="Uniform"
                                      Width="18" Height="18">
                                    <Path.Style>
                                        <Style TargetType="Path">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsMouseOver, ElementName=TogglePasswordBtn}" Value="True">
                                                    <Setter Property="Opacity" Value="0.7"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Path.Style>
                                </Path>
                            </Button>
                        </Grid>
                    </Border>

                    <Border x:Name="LoginButton"
                            Background="#0C2B38"
                            CornerRadius="15"
                            Height="40"
                            Width="150"
                            Cursor="Hand"
                            Margin="0 0 0 20"
                            MouseEnter="LoginButton_MouseEnter"
                            MouseLeave="LoginButton_MouseLeave"
                            MouseDown="Login_Click">

                        <Border.RenderTransform>
                            <ScaleTransform ScaleX="1" ScaleY="1"/>
                        </Border.RenderTransform>

                        <TextBlock Text="Log in"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Center"
                                   Foreground="White"
                                   FontSize="18"
                                   FontWeight="SemiBold"/>
                    </Border>

                    <!-- FORGOT PASSWORD BUTTON -->
                    <Button Content="Forgot password?"
                            Name="ForgotPwdBtn"
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="#00A6FB"
                            FontSize="14"
                            Click="ForgotPassword_Click"
                            Cursor="Hand"
                            HorizontalAlignment="Center">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <TextBlock x:Name="Txt" Text="{TemplateBinding Content}" 
                                                       Foreground="{TemplateBinding Foreground}"/>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Txt" Property="TextDecorations" Value="Underline"/>
                                                    <Setter TargetName="Txt" Property="Foreground" Value="#00A6FB"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>

                    <!-- ADMIN LINK -->
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                Margin="0,10,0,0">

                        <TextBlock Text="Don't have an account? Contact the "
                                   Foreground="#E0E0E0"/>

                        <Button Content="Admin"
                                Background="Transparent"
                                BorderThickness="0"
                                Foreground="#00A6FB"
                                FontSize="14"
                                Click="Admin_Click"
                                Cursor="Hand">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <TextBlock x:Name="Txt" Text="{TemplateBinding Content}" 
                                                           Foreground="{TemplateBinding Foreground}"/>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Txt" Property="TextDecorations" Value="Underline"/>
                                                        <Setter TargetName="Txt" Property="Foreground" Value="#00A6FB"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>

                </StackPanel>
            </Border>

        </Grid>

        <!-- LOADING OVERLAY -->
        <views:LoadingOverlay x:Name="LoginLoadingOverlay"
                               Visibility="Collapsed"
                               Grid.ZIndex="100"/>
    </Grid>
</Window>