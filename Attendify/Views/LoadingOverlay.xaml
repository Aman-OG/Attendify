<UserControl x:Class="Attendify.Views.LoadingOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:uc="clr-namespace:Attendify.Views.UserControls"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <!-- Semi-transparent blurred background -->
        <Border Background="#44000000">
            <Border.Effect>
                <BlurEffect Radius="20"/>
            </Border.Effect>
        </Border>

        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
            <!-- Native Premium Spinner -->
            <uc:LoadingSpinner Width="60" Height="60" Margin="0,0,0,20"/>
            
            <TextBlock x:Name="StatusText"
                       Text="Please wait..." 
                       Foreground="White" 
                       FontSize="16" 
                       FontWeight="Bold"
                       HorizontalAlignment="Center">
                <TextBlock.Effect>
                    <DropShadowEffect BlurRadius="10" ShadowDepth="0" Color="Black"/>
                </TextBlock.Effect>
            </TextBlock>
        </StackPanel>
    </Grid>
</UserControl>
