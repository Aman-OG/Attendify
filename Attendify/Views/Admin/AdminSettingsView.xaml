<UserControl x:Class="Attendify.Views.UserControls.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:views="clr-namespace:Attendify.Views"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="900"
             Background="Transparent">

    <UserControl.Resources>
        <!-- Glass container style -->
        <ControlTemplate x:Key="GlassContainerTemplate" TargetType="ContentControl">
            <Grid>
                <Border CornerRadius="10">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#03FFFFFF" Offset="0" />
                            <GradientStop Color="#03FFFFFF" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="18" Opacity="0.18" ShadowDepth="2"/>
                    </Border.Effect>
                </Border>
                <Border CornerRadius="10" Padding="12" Background="#22FFFFFF" BorderBrush="#40FFFFFF" BorderThickness="1">
                    <ContentPresenter />
                </Border>
            </Grid>
        </ControlTemplate>

        <!-- Modern Button Style -->
        <Style x:Key="ModernButton" TargetType="Button">
            <Setter Property="Background" Value="#00A6FB"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="15,10"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#0088CC"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#006699"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Secondary Button Style -->
        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource ModernButton}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#00A6FB"/>
            <Setter Property="BorderBrush" Value="#00A6FB"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <!-- TextBox Style -->
        <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="#10FFFFFF"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#20FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,6"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost" 
                                          Margin="{TemplateBinding Padding}"
                                          Background="Transparent"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#00A6FB"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        
        
        

        <!-- SIMPLE WORKING COMBOBOX STYLE -->
        <Style x:Key="GlassComboBox" TargetType="ComboBox">
            <Setter Property="Background" Value="#20FFFFFF"/>
            <Setter Property="BorderBrush" Value="#40FFFFFF"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <!-- Main border with rounded corners -->
                            <Border x:Name="MainBorder"
                              CornerRadius="10"
                              Background="{TemplateBinding Background}"
                              BorderBrush="{TemplateBinding BorderBrush}"
                              BorderThickness="{TemplateBinding BorderThickness}">

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="30"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Content -->
                                    <ContentPresenter Grid.Column="0"
                                              HorizontalAlignment="Left"
                                              VerticalAlignment="Center"
                                              Margin="12,0,0,0"
                                              Content="{TemplateBinding SelectionBoxItem}"/>

                                    <!-- Arrow -->
                                    <Path x:Name="ArrowPath"
                                  Grid.Column="1"
                                  Fill="White"
                                  Data="M 0 0 L 4 4 L 8 0 Z"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  Width="8" Height="6"/>
                                </Grid>
                            </Border>

                            <!-- Toggle Button - Make it NOT cover the entire area -->
                            <ToggleButton x:Name="ToggleButton"
                                  Background="Transparent"
                                  BorderBrush="Transparent"
                                  HorizontalAlignment="Right"
                                  VerticalAlignment="Stretch"
                                  Width="40"
                                  IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"/>

                            <!-- Dropdown Popup -->
                            <Popup x:Name="PART_Popup"
                           Placement="Bottom"
                           IsOpen="{TemplateBinding IsDropDownOpen}"
                           AllowsTransparency="True"
                           PopupAnimation="Slide">
                                <Border CornerRadius="10"
                                Background="#70FFFFFF"
                                BorderBrush="#40FFFFFF"
                                BorderThickness="1"
                                MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                                    <ScrollViewer MaxHeight="200">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="MainBorder" Property="Background" Value="#4000A6FB"/>
                                <Setter TargetName="MainBorder" Property="BorderBrush" Value="#6000A6FB"/>
                                <Setter TargetName="ArrowPath" Property="Fill" Value="#E6F5FF"/>
                            </Trigger>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="MainBorder" Property="BorderBrush" Value="#FF00A6FB"/>
                                <Setter TargetName="ArrowPath" Property="Fill" Value="#E6F5FF"/>
                            </Trigger>
                            <Trigger Property="IsDropDownOpen" Value="True">
                                <Setter TargetName="MainBorder" Property="Background" Value="#5000A6FB"/>
                                <Setter TargetName="MainBorder" Property="BorderBrush" Value="#FF00A6FB"/>
                                <Setter TargetName="ArrowPath" Property="Fill" Value="#E6F5FF"/>
                                <Setter TargetName="ArrowPath" Property="Data" Value="M 0 4 L 4 0 L 8 4 Z"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ComboBoxItem Style -->
        <Style x:Key="GlassComboBoxItem" TargetType="ComboBoxItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Bg" 
                                Background="{TemplateBinding Background}" 
                                Padding="{TemplateBinding Padding}"
                                CornerRadius="6">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#30FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#40FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- DataGrid Style with Transparent Headers -->
        <Style x:Key="ModernDataGrid" TargetType="DataGrid">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="GridLinesVisibility" Value="None"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
            <Setter Property="ScrollViewer.PanningMode" Value="Both"/>
            <Setter Property="Stylus.IsFlicksEnabled" Value="False"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="SelectionUnit" Value="FullRow"/>
            <Setter Property="MaxHeight" Value="300"/>
        </Style>

        <!-- DataGrid Column Header Style -->
        <Style x:Key="GlassColumnHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#00A6FB"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridColumnHeader">
                        <Border x:Name="HeaderBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8,8,0,0"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="HeaderBorder" Property="Background" Value="#2000A6FB"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="HeaderBorder" Property="Background" Value="#4000A6FB"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- DataGridRow Style -->
        <Style x:Key="DataGridRowStyle" TargetType="DataGridRow">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#2000A6FB"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#4000A6FB"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Tab Button Style -->
        <Style x:Key="TabButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#CCCCCC"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="20,12"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}"
                                BorderBrush="#00A6FB"
                                BorderThickness="0,0,0,2">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Toggle Switch Style -->
        <Style x:Key="ToggleSwitchStyle" TargetType="CheckBox">
            <Setter Property="Background" Value="#666666"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="50"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}"
                                CornerRadius="12"
                                Width="50" Height="24">
                            <Ellipse x:Name="thumb" 
                                     Fill="White" 
                                     Width="20" Height="20"
                                     HorizontalAlignment="Left" 
                                     VerticalAlignment="Center"
                                     Margin="2"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#00A6FB"/>
                                <Setter TargetName="thumb" Property="HorizontalAlignment" Value="Right"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Settings Header -->
        <ContentControl Grid.Row="0" Template="{StaticResource GlassContainerTemplate}" Margin="0,0,0,15">
            <StackPanel>
                <TextBlock Text="Admin Settings" 
                           Foreground="#00A6FB" 
                           FontSize="24" 
                           FontWeight="Bold"
                           Margin="0,0,0,10"/>

                <!-- Tab Navigation -->
                <StackPanel Orientation="Horizontal">

                    <Button x:Name="BtnShifts" 
                            Content="Shifts" 
                            Style="{StaticResource TabButtonStyle}"
                            Click="TabButton_Click"/>
                    <Button x:Name="BtnBroadcastMessages" 
                            Content="Broadcast Messages" 
                            Style="{StaticResource TabButtonStyle}"
                            Click="TabButton_Click"/>
                    <Button x:Name="BtnEmployeeRequests" 
                            Content="Employee Requests" 
                            Style="{StaticResource TabButtonStyle}"
                            Click="TabButton_Click"/>
                </StackPanel>
            </StackPanel>
        </ContentControl>

        <!-- Content Area - Main ScrollViewer -->
        <ScrollViewer Grid.Row="1" 
                      VerticalScrollBarVisibility="Auto" 
                      HorizontalScrollBarVisibility="Disabled"
                      Padding="0"
                      Margin="0">
            <ContentControl Template="{StaticResource GlassContainerTemplate}">
                <Grid>
                    <!-- Attendance Rules Panel -->


                    <!-- Shifts Panel -->
                    <Grid x:Name="ShiftsPanel" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Header -->
                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,15">
                            <TextBlock Text="Shifts" 
                                       Foreground="#00A6FB" 
                                       FontSize="18" 
                                       FontWeight="Bold"
                                       VerticalAlignment="Center"/>
                            <Button x:Name="BtnAddShift" 
                                    Content="+ Add Shift" 
                                    Style="{StaticResource ModernButton}"
                                    Margin="20,0,0,0"
                                    Click="BtnAddShift_Click"/>
                        </StackPanel>

                        <!-- DataGrid -->
                        <DataGrid Grid.Row="1"
                                  x:Name="ShiftsGrid"
                                  Style="{StaticResource ModernDataGrid}"
                                  RowStyle="{StaticResource DataGridRowStyle}"
                                  ColumnHeaderStyle="{StaticResource GlassColumnHeaderStyle}"
                                  AutoGenerateColumns="False"
                                  Margin="0,0,0,15"
                                  Height="Auto">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Shift Name" Binding="{Binding Name}" Width="*"/>
                                <DataGridTextColumn Header="Start Time" Binding="{Binding StartTime}" Width="*"/>
                                <DataGridTextColumn Header="End Time" Binding="{Binding EndTime}" Width="*"/>
                                <DataGridTextColumn Header="Grace Period" Binding="{Binding GracePeriod}" Width="*"/>
                                <DataGridTemplateColumn Header="Actions" Width="120">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <Button Content="Edit" 
                                                        Style="{StaticResource SecondaryButton}"
                                                        Padding="8,4"
                                                        Click="EditShift_Click"/>
                                                <TextBlock Text="|" Foreground="#666666" Margin="5,0" VerticalAlignment="Center"/>
                                                <Button Content="Delete" 
                                                        Style="{StaticResource SecondaryButton}"
                                                        Padding="8,4"
                                                        Click="DeleteShift_Click"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <!-- Add/Edit Shift Form -->
                        <ContentControl Grid.Row="2"
                                        x:Name="ShiftFormContainer" 
                                        Template="{StaticResource GlassContainerTemplate}"
                                        Visibility="Collapsed">
                            <StackPanel Margin="10">
                                <TextBlock Text="Add/Edit Shift" 
                                           Foreground="#00A6FB" 
                                           FontSize="16" 
                                           FontWeight="Bold"
                                           Margin="0,0,0,15"/>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Shift Name -->
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Shift Name" 
                                                   Foreground="White" 
                                                   FontWeight="SemiBold"
                                                   Margin="0,0,0,5"/>
                                        <TextBox x:Name="TxtShiftName" 
                                                 Style="{StaticResource ModernTextBox}"
                                                 Text="Morning"/>
                                    </StackPanel>

                                    <!-- Start Time -->
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Start Time" 
                                                   Foreground="White" 
                                                   FontWeight="SemiBold"
                                                   Margin="0,0,0,5"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="100"/>
                                                <ColumnDefinition Width="100"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox x:Name="TxtShiftStart" 
                                                     Style="{StaticResource ModernTextBox}"
                                                     Text="08:00"
                                                     Margin="0,0,5,0"/>
                                            <TextBox Grid.Column="1"
                                                     x:Name="TxtShiftStartAmPm"
                                                     Style="{StaticResource ModernTextBox}"
                                                     Width="90"
                                                     Text="AM"
                                                     HorizontalContentAlignment="Center"/>
                                        </Grid>
                                    </StackPanel>

                                    <!-- End Time -->
                                    <StackPanel Grid.Column="4">
                                        <TextBlock Text="End Time" 
                                                   Foreground="White" 
                                                   FontWeight="SemiBold"
                                                   Margin="0,0,0,5"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="100"/>
                                                <ColumnDefinition Width="100"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox x:Name="TxtShiftEnd" 
                                                     Style="{StaticResource ModernTextBox}"
                                                     Text="02:00"
                                                     Margin="0,0,5,0"/>
                                            <TextBox Grid.Column="1"
                                                     x:Name="TxtShiftEndAmPm"
                                                     Style="{StaticResource ModernTextBox}"
                                                     Width="90"
                                                     Text="PM"
                                                     HorizontalContentAlignment="Center"/>
                                        </Grid>
                                    </StackPanel>
                                </Grid>

                                <!-- Grace Period -->
                                <StackPanel Margin="0,15,0,0">
                                    <TextBlock Text="Grace Period (minutes)" 
                                               Foreground="White" 
                                               FontWeight="SemiBold"
                                               Margin="0,0,0,5"/>
                                    <TextBox x:Name="TxtShiftGrace" 
                                             Style="{StaticResource ModernTextBox}"
                                             Text="5"/>
                                </StackPanel>

                                <!-- Buttons -->
                                <StackPanel Orientation="Horizontal" 
                                            HorizontalAlignment="Right" 
                                            Margin="0,15,0,0">
                                    <Button x:Name="BtnSaveShift" 
                                            Content="Save Shift" 
                                            Style="{StaticResource ModernButton}"
                                            Margin="0,0,10,0"
                                            Click="BtnSaveShift_Click"/>
                                    <Button x:Name="BtnCancelShift" 
                                            Content="Cancel" 
                                            Style="{StaticResource SecondaryButton}"
                                            Click="BtnCancelShift_Click"/>
                                </StackPanel>
                            </StackPanel>
                        </ContentControl>
                    </Grid>

                    <!-- Broadcast Messages Panel -->
                    <Grid x:Name="MessagesPanel" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Header -->
                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,15">
                            <TextBlock Text="Broadcast Messages" 
                                       Foreground="#00A6FB" 
                                       FontSize="18" 
                                       FontWeight="Bold"
                                       VerticalAlignment="Center"/>
                            <Button x:Name="BtnNewMessage" 
                                    Content="+ New Message" 
                                    Style="{StaticResource ModernButton}"
                                    Margin="20,0,0,0"
                                    Click="BtnNewMessage_Click"/>
                        </StackPanel>

                        <!-- DataGrid -->
                        <DataGrid Grid.Row="1"
                                  x:Name="MessagesGrid"
                                  Style="{StaticResource ModernDataGrid}"
                                  RowStyle="{StaticResource DataGridRowStyle}"
                                  ColumnHeaderStyle="{StaticResource GlassColumnHeaderStyle}"
                                  AutoGenerateColumns="False"
                                  Margin="0,0,0,15"
                                  Height="Auto">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Title" Binding="{Binding Title}" Width="*"/>
                                <DataGridTemplateColumn Header="Status" Width="80">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Background="{Binding StatusColor}" 
                                                    CornerRadius="10" 
                                                    Padding="5,2"
                                                    HorizontalAlignment="Left">
                                                <TextBlock Text="{Binding Status}" 
                                                           Foreground="White" 
                                                           FontWeight="SemiBold"
                                                           FontSize="11"
                                                           HorizontalAlignment="Center"/>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Created" Binding="{Binding CreatedDate}" Width="*"/>
                                <DataGridTemplateColumn Header="Actions" Width="120">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <Button Content="Edit" 
                                                        Style="{StaticResource SecondaryButton}"
                                                        Padding="8,4"
                                                        Click="EditMessage_Click"/>
                                                <TextBlock Text="|" Foreground="#666666" Margin="5,0" VerticalAlignment="Center"/>
                                                <Button Content="Delete" 
                                                        Style="{StaticResource SecondaryButton}"
                                                        Padding="8,4"
                                                        Click="DeleteMessage_Click"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <!-- Add/Edit Message Form -->
                        <ContentControl Grid.Row="2"
                                        x:Name="MessageFormContainer" 
                                        Template="{StaticResource GlassContainerTemplate}"
                                        Visibility="Collapsed">
                            <StackPanel Margin="10">
                                <TextBlock Text="Create/Edit Message" 
                                           Foreground="#00A6FB" 
                                           FontSize="16" 
                                           FontWeight="Bold"
                                           Margin="0,0,0,15"/>

                                <!-- Title -->
                                <StackPanel>
                                    <TextBlock Text="Title" 
                                               Foreground="White" 
                                               FontWeight="SemiBold"
                                               Margin="0,0,0,5"/>
                                    <TextBox x:Name="TxtMessageTitle" 
                                             Style="{StaticResource ModernTextBox}"/>
                                </StackPanel>

                                <!-- Body -->
                                <StackPanel Margin="0,15,0,0">
                                    <TextBlock Text="Message Body" 
                                               Foreground="White" 
                                               FontWeight="SemiBold"
                                               Margin="0,0,0,5"/>
                                    <TextBox x:Name="TxtMessageBody" 
                                             Style="{StaticResource ModernTextBox}"
                                             Height="100"
                                             TextWrapping="Wrap"
                                             AcceptsReturn="True"
                                             VerticalScrollBarVisibility="Auto"/>
                                </StackPanel>

                                <!-- Active Status -->
                                <StackPanel Orientation="Horizontal" Margin="0,15,0,0">
                                    <CheckBox x:Name="ChkIsActive" 
                                              Style="{StaticResource ToggleSwitchStyle}"
                                              VerticalAlignment="Center"/>
                                    <TextBlock Text="Active" 
                                               Foreground="White" 
                                               FontWeight="SemiBold"
                                               Margin="10,0,0,0"
                                               VerticalAlignment="Center"/>
                                </StackPanel>

                                <!-- Buttons -->
                                <StackPanel Orientation="Horizontal" 
                                            HorizontalAlignment="Right" 
                                            Margin="0,15,0,0">
                                    <Button x:Name="BtnSaveMessage" 
                                            Content="Save Message" 
                                            Style="{StaticResource ModernButton}"
                                            Margin="0,0,10,0"
                                            Click="BtnSaveMessage_Click"/>
                                    <Button x:Name="BtnCancelMessage" 
                                            Content="Cancel" 
                                            Style="{StaticResource SecondaryButton}"
                                            Click="BtnCancelMessage_Click"/>
                                </StackPanel>
                            </StackPanel>
                        </ContentControl>
                    </Grid>

                    <!-- Employee Requests Panel -->
                    <Grid x:Name="RequestsPanel" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

           

                        <!-- Requests Table -->
                        <DataGrid Grid.Row="1"
                                  x:Name="RequestsGrid"
                                  Style="{StaticResource ModernDataGrid}"
                                  RowStyle="{StaticResource DataGridRowStyle}"
                                  ColumnHeaderStyle="{StaticResource GlassColumnHeaderStyle}"
                                  AutoGenerateColumns="False"
                                  SelectionChanged="RequestsGrid_SelectionChanged"
                                  Margin="0,0,0,15"
                                  Height="Auto">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="EmpID" Binding="{Binding EmployeeID}" Width="80"/>
                                <DataGridTextColumn Header="Name" Binding="{Binding EmployeeName}" Width="*"/>
                                <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="*"/>
                                <DataGridTextColumn Header="Message" Binding="{Binding Message}" Width="2*"/>
                                <DataGridTemplateColumn Header="Status" Width="100">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Background="{Binding StatusColor}" 
                                                    CornerRadius="10" 
                                                    Padding="5,2"
                                                    HorizontalAlignment="Left">
                                                <TextBlock Text="{Binding Status}" 
                                                           Foreground="White" 
                                                           FontWeight="SemiBold"
                                                           FontSize="11"
                                                           HorizontalAlignment="Center"/>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Actions" Width="100">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="Review" 
                                                    Style="{StaticResource ModernButton}"
                                                    Padding="8,4"
                                                    Click="ReviewRequest_Click"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <!-- Review Panel -->
                        <ContentControl Grid.Row="2"
                                        x:Name="ReviewPanel" 
                                        Template="{StaticResource GlassContainerTemplate}"
                                        Visibility="Collapsed">
                            <StackPanel Margin="10">
                                <TextBlock Text="Employee Request Details" 
                                           Foreground="#00A6FB" 
                                           FontSize="16" 
                                           FontWeight="Bold"
                                           Margin="0,0,0,15"/>

                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Employee -->
                                    <TextBlock Grid.Row="0" Grid.Column="0" 
                                               Text="Employee:" 
                                               Foreground="White" 
                                               FontWeight="SemiBold"
                                               Margin="0,0,10,8"/>
                                    <TextBlock Grid.Row="0" Grid.Column="1" 
                                               x:Name="TxtReviewEmployee"
                                               Foreground="#CCCCCC" 
                                               Margin="0,0,0,8"/>

                                    <!-- Type -->
                                    <TextBlock Grid.Row="1" Grid.Column="0" 
                                               Text="Type:" 
                                               Foreground="White" 
                                               FontWeight="SemiBold"
                                               Margin="0,0,10,8"/>
                                    <TextBlock Grid.Row="1" Grid.Column="1" 
                                               x:Name="TxtReviewType"
                                               Foreground="#CCCCCC" 
                                               Margin="0,0,0,8"/>

                                    <!-- Message -->
                                    <TextBlock Grid.Row="2" Grid.Column="0" 
                                               Text="Message:" 
                                               Foreground="White" 
                                               FontWeight="SemiBold"
                                               Margin="0,0,10,8"/>
                                    <TextBlock Grid.Row="2" Grid.Column="1" 
                                               x:Name="TxtReviewMessage"
                                               Foreground="#CCCCCC" 
                                               TextWrapping="Wrap"
                                               Margin="0,0,0,8"/>

                                    <!-- Admin Reply -->
                                    <TextBlock Grid.Row="3" Grid.Column="0" 
                                               Text="Admin Reply:" 
                                               Foreground="White" 
                                               FontWeight="SemiBold"
                                               Margin="0,0,10,8"/>
                                    <TextBox Grid.Row="3" Grid.Column="1" 
                                             x:Name="TxtAdminReply"
                                             Style="{StaticResource ModernTextBox}"
                                             Height="60"
                                             TextWrapping="Wrap"
                                             AcceptsReturn="True"
                                             VerticalScrollBarVisibility="Auto"
                                             Margin="0,0,0,8"/>

                                    <!-- Status -->
                                    <TextBlock Grid.Row="4" Grid.Column="0" 
                                               Text="Status:" 
                                               Foreground="White" 
                                               FontWeight="SemiBold"
                                               Margin="0,0,10,8"/>
                                    <StackPanel Grid.Row="4" Grid.Column="1" 
                                                Orientation="Horizontal"
                                                Margin="0,0,0,8">
                                        <RadioButton x:Name="RadioApprove" 
                                                     Content="Approve" 
                                                     Foreground="White"
                                                     Margin="0,0,15,0"
                                                     GroupName="RequestStatus"/>
                                        <RadioButton x:Name="RadioReject" 
                                                     Content="Reject" 
                                                     Foreground="White"
                                                     GroupName="RequestStatus"/>
                                    </StackPanel>

                                    <!-- Submit Button -->
                                    <Button Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="2"
                                            x:Name="BtnSubmitDecision"
                                            Content="Submit Decision" 
                                            Style="{StaticResource ModernButton}"
                                            HorizontalAlignment="Center"
                                            Margin="0,15,0,0"
                                            Click="BtnSubmitDecision_Click"/>
                                </Grid>
                            </StackPanel>
                        </ContentControl>
                    </Grid>
                </Grid>
            </ContentControl>
        </ScrollViewer>
        <!-- Loading Overlay -->
        <views:LoadingOverlay x:Name="LoadingOverlay" 
                              Grid.RowSpan="2" 
                              Visibility="Collapsed"
                              Panel.ZIndex="1000"/>
    </Grid>
</UserControl>