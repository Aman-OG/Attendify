<UserControl x:Class="Attendify.Views.UserControls.ReportsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:lc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1000"
             Background="Transparent">

    <UserControl.Resources>
        <!-- Glass container style -->
        <Style x:Key="GlassRoundedBorder" TargetType="Border">
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#33FFFFFF" Offset="0" />
                        <GradientStop Color="#13FFFFFF" Offset="1" />
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="BorderBrush" Value="#40FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="15"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="18" Opacity="0.18" ShadowDepth="2"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- KPI Card Style -->
        <Style x:Key="KpiCardStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#40FFFFFF" Offset="0"/>
                        <GradientStop Color="#20FFFFFF" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="BorderBrush" Value="#60FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Width" Value="180"/>
            <Setter Property="Height" Value="90"/>
            <Setter Property="Margin" Value="8"/>
            <Setter Property="Padding" Value="15"/>
        </Style>

        <!-- Export Button Style -->
        <Style x:Key="ExportButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#20FFFFFF"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" 
                                CornerRadius="8"
                                Background="{TemplateBinding Background}"
                                BorderBrush="#40FFFFFF"
                                BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#4000A6FB"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20">
        <StackPanel>
            <!-- Header -->
            <TextBlock Text="📊 Analytics and Reports" 
                       FontSize="28" 
                       FontWeight="Bold" 
                       Foreground="White" 
                       Margin="0,0,0,20"/>

            <!-- Date Range Filter -->
            <Border Style="{StaticResource GlassRoundedBorder}" Margin="0,0,0,20">
                <StackPanel Orientation="Horizontal" Height="50" VerticalAlignment="Center">
                    <TextBlock Text="Date Range:" 
                               Foreground="White" 
                               FontWeight="SemiBold" 
                               FontSize="14"
                               Margin="0,0,15,0"
                               VerticalAlignment="Center"/>

                    <DatePicker x:Name="StartDatePicker" 
                                Width="130" 
                                Height="35"
                                Margin="0,0,10,0"
                                VerticalAlignment="Center"/>

                    <TextBlock Text="to" 
                               Foreground="White" 
                               Margin="0,0,10,0"
                               VerticalAlignment="Center"/>

                    <DatePicker x:Name="EndDatePicker" 
                                Width="130" 
                                Height="35"
                                Margin="0,0,20,0"
                                VerticalAlignment="Center"/>

                    <Button Content="Apply Filter" 
                            Background="#00A6FB"
                            Foreground="White"
                            Padding="20,10"
                            FontWeight="SemiBold"
                            Click="ApplyFilter_Click"
                            Cursor="Hand"/>
                </StackPanel>
            </Border>

            <!-- KPI Cards -->
            <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,25">
                <!-- Total Employees -->
                <Border Style="{StaticResource KpiCardStyle}">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="142" 
                                   FontSize="24" 
                                   FontWeight="Bold" 
                                   Foreground="#00A6FB" 
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="Total Employees" 
                                   FontSize="11" 
                                   Foreground="White" 
                                   HorizontalAlignment="Center"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Today's Attendance -->
                <Border Style="{StaticResource KpiCardStyle}">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="89%" 
                                   FontSize="24" 
                                   FontWeight="Bold" 
                                   Foreground="#2FBF4C" 
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="Today's Attendance" 
                                   FontSize="11" 
                                   Foreground="White" 
                                   HorizontalAlignment="Center"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Pending Leaves -->
                <Border Style="{StaticResource KpiCardStyle}">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="18" 
                                   FontSize="24" 
                                   FontWeight="Bold" 
                                   Foreground="#E3C63A" 
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="Pending Leaves" 
                                   FontSize="11" 
                                   Foreground="White" 
                                   HorizontalAlignment="Center"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Attendance Rate -->
                <Border Style="{StaticResource KpiCardStyle}">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="94%" 
                                   FontSize="24" 
                                   FontWeight="Bold" 
                                   Foreground="#A95315" 
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="Attendance Rate" 
                                   FontSize="11" 
                                   Foreground="White" 
                                   HorizontalAlignment="Center"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"/>
                    </StackPanel>
                </Border>
            </WrapPanel>

            <!-- Charts Grid -->
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="300"/>
                    <RowDefinition Height="300"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Attendance Trend Line Chart -->
                <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource GlassRoundedBorder}" Margin="5">
                    <StackPanel>
                        <TextBlock Text="📈 Monthly Attendance Trend" 
                                   FontSize="16" 
                                   FontWeight="Bold" 
                                   Foreground="White" 
                                   Margin="0,0,0,10"/>
                        <lc:CartesianChart 
                            Series="{Binding AttendanceTrendSeries}"
                            XAxes="{Binding XAxes}"
                            YAxes="{Binding YAxes}"
                            Height="220">
                            <lc:CartesianChart.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#10FFFFFF" Offset="0"/>
                                    <GradientStop Color="#05FFFFFF" Offset="1"/>
                                </LinearGradientBrush>
                            </lc:CartesianChart.Background>
                        </lc:CartesianChart>
                    </StackPanel>
                </Border>

                <!-- Leave Distribution Pie Chart -->
                <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource GlassRoundedBorder}" Margin="5">
                    <StackPanel>
                        <TextBlock Text="🥧 Leave Status Distribution" 
                                   FontSize="16" 
                                   FontWeight="Bold" 
                                   Foreground="White" 
                                   Margin="0,0,0,10"/>
                        <lc:PieChart 
                            Series="{Binding LeaveDistributionSeries}"
                            Height="220">
                            <lc:PieChart.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#10FFFFFF" Offset="0"/>
                                    <GradientStop Color="#05FFFFFF" Offset="1"/>
                                </LinearGradientBrush>
                            </lc:PieChart.Background>
                        </lc:PieChart>
                    </StackPanel>
                </Border>

                <!-- Department Leave Bar Chart -->
                <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource GlassRoundedBorder}" Margin="5">
                    <StackPanel>
                        <TextBlock Text="📊 Department Leave Comparison" 
                                   FontSize="16" 
                                   FontWeight="Bold" 
                                   Foreground="White" 
                                   Margin="0,0,0,10"/>
                        <lc:CartesianChart 
                            Series="{Binding DepartmentLeaveSeries}"
                            XAxes="{Binding DepartmentXAxes}"
                            YAxes="{Binding DepartmentYAxes}"
                            Height="220">
                            <lc:CartesianChart.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#10FFFFFF" Offset="0"/>
                                    <GradientStop Color="#05FFFFFF" Offset="1"/>
                                </LinearGradientBrush>
                            </lc:CartesianChart.Background>
                        </lc:CartesianChart>
                    </StackPanel>
                </Border>

                <!-- Export Panel -->
                <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource GlassRoundedBorder}" Margin="5">
                    <StackPanel>
                        <TextBlock Text="📤 Export Reports" 
                                   FontSize="16" 
                                   FontWeight="Bold" 
                                   Foreground="White" 
                                   Margin="0,0,0,15"/>

                        <StackPanel Orientation="Vertical">
                            <Button Content="📄 Export Attendance Report (PDF)" 
                                    Style="{StaticResource ExportButtonStyle}"
                                    Click="ExportAttendancePdf_Click"
                                    Margin="0,0,0,10"/>

                            <Button Content="📊 Export Leave Summary (Excel)" 
                                    Style="{StaticResource ExportButtonStyle}"
                                    Click="ExportLeaveExcel_Click"
                                    Margin="0,0,0,10"/>

                            <Button Content="👥 Export Employee List (CSV)" 
                                    Style="{StaticResource ExportButtonStyle}"
                                    Click="ExportEmployeeCsv_Click"
                                    Margin="0,0,0,10"/>

                            <Button Content="📈 Export Analytics (PDF)" 
                                    Style="{StaticResource ExportButtonStyle}"
                                    Click="ExportAnalyticsPdf_Click"/>
                        </StackPanel>

                        <!-- Summary Stats -->
                        <StackPanel Margin="0,20,0,0">
                            <TextBlock Text="📋 Quick Summary" 
                                       FontSize="14" 
                                       FontWeight="SemiBold" 
                                       Foreground="White" 
                                       Margin="0,0,0,10"/>

                            <TextBlock Text="• Period: Last 30 days&#x0a;• Average Daily Attendance: 92%&#x0a;• Total Leave Requests: 45&#x0a;• Most Active Department: HR (12 leaves)&#x0a;• Best Attendance: IT Department (98%)" 
                                       FontSize="12" 
                                       Foreground="#CCCCCC" 
                                       TextWrapping="Wrap"
                                       LineHeight="18"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>