<UserControl x:Class="Attendify.Views.UserControls.ReportsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:oxy="http://oxyplot.org/wpf"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1000"
             Background="Transparent">

    <UserControl.Resources>

        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>

        <!-- Loading Overlay Style -->
        <Style x:Key="LoadingOverlayStyle" TargetType="Border">
            <Setter Property="Background" Value="#80000000"/>
            <Setter Property="VerticalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="Panel.ZIndex" Value="1000"/>
        </Style>

        <!-- Glass container style -->
        <Style x:Key="GlassRoundedBorder" TargetType="Border">
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#33FFFFFF" Offset="0" />
                        <GradientStop Color="#13FFFFFF" Offset="1" />
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="BorderBrush" Value="#30FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="15"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="18" Opacity="0.18" ShadowDepth="2"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- KPI Card Style -->
        <Style x:Key="KpiCardStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#40FFFFFF" Offset="0"/>
                        <GradientStop Color="#20FFFFFF" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="BorderBrush" Value="#60FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Width" Value="180"/>
            <Setter Property="Height" Value="90"/>
            <Setter Property="Margin" Value="8"/>
            <Setter Property="Padding" Value="15"/>
        </Style>

        <!-- Export Button Style -->
        <Style x:Key="ExportButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#20FFFFFF"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" 
                                CornerRadius="8"
                                Background="{TemplateBinding Background}"
                                BorderBrush="#40FFFFFF"
                                BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#4000A6FB"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Rounded Button Style -->
        <Style x:Key="RoundedButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#00A6FB"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" 
                                CornerRadius="8"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#0088CC"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Simple DatePicker Style that works -->
        <Style x:Key="ModernDatePicker" TargetType="DatePicker">
            <Setter Property="Background" Value="#20FFFFFF"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#40FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Height" Value="25"/>
            <Setter Property="Width" Value="140"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <!-- OxyPlot Style -->
        <Style x:Key="OxyPlotChartStyle" TargetType="oxy:PlotView">
            <Setter Property="Height" Value="220"/>
            <Setter Property="Background" Value="Transparent"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20">
        <StackPanel>
            <!-- Header -->
            <TextBlock Text="📊 Analytics and Reports" 
                       FontSize="28" 
                       FontWeight="Bold" 
                       Foreground="White" 
                       Margin="0,0,0,20"/>

            <!-- Modern Date Range Filter -->
            <Border Style="{StaticResource GlassRoundedBorder}" Margin="0,0,0,20">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="📅 Date Range:" 
                               Foreground="White" 
                               FontWeight="SemiBold" 
                               FontSize="14"
                               Margin="0,0,15,0"
                               VerticalAlignment="Center"/>

                    <DatePicker x:Name="StartDatePicker" 
                                Style="{StaticResource ModernDatePicker}"
                                Margin="0,0,10,0"
                                Foreground="black" />

                    <TextBlock Text="to" 
                               Foreground="#80FFFFFF" 
                               Margin="0,0,10,0"
                               VerticalAlignment="Center"
                               FontSize="12"/>

                    <DatePicker x:Name="EndDatePicker" 
                                Style="{StaticResource ModernDatePicker}"
                                Margin="0,0,20,0"
                                Foreground="black" />

                    <Button Content="🔍 Apply Filter" 
                            Style="{StaticResource RoundedButtonStyle}"
                            Click="ApplyFilter_Click"/>
                </StackPanel>
            </Border>
            <!-- Add Loading Overlay -->
            <Border x:Name="LoadingOverlay" 
        Grid.RowSpan="3" 
        Background="#80000000"
        VerticalAlignment="Stretch"
        HorizontalAlignment="Stretch"
        Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}"
        Panel.ZIndex="1000">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <ProgressBar IsIndeterminate="True" Width="200" Height="10" Margin="0,0,0,10"/>
                    <TextBlock Text="{Binding LoadingMessage}" 
                   Foreground="White" 
                   FontSize="14" 
                   FontWeight="Bold"/>
                </StackPanel>
            </Border>
            <!-- KPI Cards -->
            <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,25">
                <!-- Total Employees -->
                <Border Style="{StaticResource KpiCardStyle}">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding TotalEmployees}"
                                   FontSize="24" 
                                   FontWeight="Bold" 
                                   Foreground="#00A6FB" 
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="Total Employees" 
                                   FontSize="11" 
                                   Foreground="White" 
                                   HorizontalAlignment="Center"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Today's Attendance -->
                <Border Style="{StaticResource KpiCardStyle}">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding TodayAttendancePercentage, StringFormat={}{0}%}"
                                   FontSize="24" 
                                   FontWeight="Bold" 
                                   Foreground="#2FBF4C" 
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="Today's Attendance" 
                                   FontSize="11" 
                                   Foreground="White" 
                                   HorizontalAlignment="Center"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Pending Leaves -->
                <Border Style="{StaticResource KpiCardStyle}">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding PendingLeaves}"  
                                   FontSize="24" 
                                   FontWeight="Bold" 
                                   Foreground="#E3C63A" 
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="Pending Leaves" 
                                   FontSize="11" 
                                   Foreground="White" 
                                   HorizontalAlignment="Center"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Attendance Rate -->
                <Border Style="{StaticResource KpiCardStyle}">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding AttendanceRate, StringFormat={}{0}%}"
                                   FontSize="24" 
                                   FontWeight="Bold" 
                                   Foreground="#A95315" 
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="Attendance Rate" 
                                   FontSize="11" 
                                   Foreground="White" 
                                   HorizontalAlignment="Center"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"/>
                    </StackPanel>
                </Border>
            </WrapPanel>

            <!-- Charts Grid -->
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="300"/>
                    <RowDefinition Height="300"/>
                    <RowDefinition Height="300"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Attendance Trend Line Chart -->
                <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource GlassRoundedBorder}" Margin="5">
                    <StackPanel>
                        <TextBlock Text="📈 Monthly Attendance Trend" 
                                   FontSize="16" 
                                   FontWeight="Bold" 
                                   Foreground="White" 
                                   Margin="0,0,0,10"/>
                        <oxy:PlotView Model="{Binding AttendanceTrendModel}" 
                                    Style="{StaticResource OxyPlotChartStyle}"/>
                    </StackPanel>
                </Border>

                <!-- Leave Distribution Pie Chart -->
                <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource GlassRoundedBorder}" Margin="5">
                    <StackPanel>
                        <TextBlock Text="🥧 Leave Status Distribution" 
                                   FontSize="16" 
                                   FontWeight="Bold" 
                                   Foreground="White" 
                                   Margin="0,0,0,10"/>
                        <oxy:PlotView Model="{Binding LeaveDistributionModel}" 
                                    Style="{StaticResource OxyPlotChartStyle}"/>
                    </StackPanel>
                </Border>

                <!-- Department Leave Bar Chart -->
                <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource GlassRoundedBorder}" Margin="5">
                    <StackPanel>
                        <TextBlock Text="📊 Department Leave Comparison" 
                                   FontSize="16" 
                                   FontWeight="Bold" 
                                   Foreground="White" 
                                   Margin="0,0,0,10"/>
                        <oxy:PlotView Model="{Binding DepartmentLeaveModel}" 
                                    Style="{StaticResource OxyPlotChartStyle}"/>
                    </StackPanel>
                </Border>
                <!-- Performance Gauge -->
                <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource GlassRoundedBorder}" Margin="5">
                    <StackPanel>
                        <TextBlock Text="🎯 Performance Overview" 
                   FontSize="16" 
                   FontWeight="Bold" 
                   Foreground="White" 
                   Margin="0,0,0,10"/>

                        <!-- Gauge with clear labels -->
                        <Grid Height="120" Margin="0,0,0,15">
                            <oxy:PlotView Model="{Binding PerformanceGaugeModel}" 
                        Background="Transparent"/>
                        </Grid>

                        <!-- Performance Stats with clear percentage breakdown -->
                        <StackPanel>
                            <TextBlock Text="📋 Attendance Breakdown" 
                       FontSize="14" 
                       FontWeight="SemiBold" 
                       Foreground="White" 
                       Margin="0,0,0,10"/>
                            <TextBlock Text="• Present: 85%&#x0a;• Absent: 15%&#x0a;• Late Arrivals: 8%&#x0a;" 
                       FontSize="12" 
                       Foreground="#CCCCCC" 
                       TextWrapping="Wrap"
                       LineHeight="18"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
                <!-- Export Reports -->
                <Border Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Style="{StaticResource GlassRoundedBorder}" Margin="5">
                    <StackPanel>
                        <TextBlock Text="📤 Export Reports" 
                                   FontSize="16" 
                                   FontWeight="Bold" 
                                   Foreground="White" 
                                   Margin="0,0,0,15"/>

                        <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Button Content="📄 Export Attendance Report (PDF)" 
                                    Style="{StaticResource ExportButtonStyle}"
                                     Command="{Binding ExportAttendancePdfCommand}"
                                    Margin="5"/>

                            <Button Content="📊 Export Leave Summary (Excel)" 
                                    Style="{StaticResource ExportButtonStyle}"
                                    Command="{Binding ExportLeaveExcelCommand}"
                                    Margin="5"/>

                            <Button Content="👥 Export Employee List (CSV)" 
                                    Style="{StaticResource ExportButtonStyle}"
                                    Command="{Binding ExportEmployeeCsvCommand}"
                                    Margin="5"/>

                            <Button Content="📈 Export Analytics (PDF)" 
                                    Style="{StaticResource ExportButtonStyle}"
                                    Command="{Binding ExportAnalyticsPdfCommand}"
                                    Margin="5"/>
                        </WrapPanel>

                        <!-- Summary Stats -->
                        <StackPanel Margin="0,20,0,0">
                            <TextBlock Text="📋 Quick Summary" 
                                       FontSize="14" 
                                       FontWeight="SemiBold" 
                                       Foreground="White" 
                                       Margin="0,0,0,10"/>

                            <TextBlock Text="• Period: Last 30 days&#x0a;• Average Daily Attendance: 92%&#x0a;• Total Leave Requests: 45&#x0a;• Most Active Department: HR (12 leaves)&#x0a;• Best Attendance: IT Department (98%)" 
                                       FontSize="12" 
                                       Foreground="#CCCCCC" 
                                       TextWrapping="Wrap"
                                       LineHeight="18"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>