<UserControl x:Class="Attendify.Views.UserControls.EmployeesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="900"
             Background="Transparent">

    <UserControl.Resources>
        
        <!-- Glass container style -->
        <ControlTemplate x:Key="GlassContainerTemplate" TargetType="ContentControl">
            <Grid>
                <Border CornerRadius="10">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#33FFFFFF" Offset="0" />
                            <GradientStop Color="#13FFFFFF" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="18" Opacity="0.18" ShadowDepth="2"/>
                    </Border.Effect>
                </Border>
                <Border CornerRadius="10" Padding="12" Background="#22FFFFFF" BorderBrush="#40FFFFFF" BorderThickness="1">
                    <ContentPresenter />
                </Border>
            </Grid>
        </ControlTemplate>

        <!-- Modern Button Style -->
        <Style x:Key="ModernButton" TargetType="Button">
            <Setter Property="Background" Value="#00A6FB"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8,3"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#0088CC"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#006699"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="#CCCCCC"/>
                                <Setter Property="Foreground" Value="#666666"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Secondary Button Style -->
        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource ModernButton}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="white"/>
            <Setter Property="BorderBrush" Value="#00A6FB"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <!-- TextBox Style -->
        <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="#20FFFFFF"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#40FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Grid>
                            <Border x:Name="border" 
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8">
                                <!-- Change from ScrollViewer to a Grid with ScrollViewer -->
                                <Grid>
                                    <ScrollViewer x:Name="PART_ContentHost"
                                          VerticalAlignment="Center"
                                          HorizontalAlignment="Stretch"
                                          Background="Transparent"/>
                                </Grid>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#00A6FB"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- SIMPLE WORKING COMBOBOX STYLE -->
        <Style x:Key="GlassComboBox" TargetType="ComboBox">
            <Setter Property="Background" Value="#20FFFFFF"/>
            <Setter Property="BorderBrush" Value="#40FFFFFF"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <!-- Main border with rounded corners -->
                            <Border x:Name="MainBorder"
                            CornerRadius="10"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="30"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Content -->
                                    <ContentPresenter Grid.Column="0"
                                              HorizontalAlignment="Left"
                                              VerticalAlignment="Center"
                                              Margin="12,0,0,0"
                                              Content="{TemplateBinding SelectionBoxItem}"/>

                                    <!-- Arrow -->
                                    <Path x:Name="ArrowPath"
                                  Grid.Column="1"
                                  Fill="White"
                                  Data="M 0 0 L 4 4 L 8 0 Z"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  Width="8" Height="6"/>
                                </Grid>
                            </Border>

                            <!-- Toggle Button - Make it NOT cover the entire area -->
                            <ToggleButton x:Name="ToggleButton"
                                  Background="Transparent"
                                  BorderBrush="Transparent"
                                  HorizontalAlignment="Right"
                                  VerticalAlignment="Stretch"
                                  Width="40"
                                  IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"/>

                            <!-- Dropdown Popup -->
                            <Popup x:Name="PART_Popup"
                           Placement="Bottom"
                           IsOpen="{TemplateBinding IsDropDownOpen}"
                           AllowsTransparency="True"
                           PopupAnimation="Slide">
                                <Border CornerRadius="10"
                                Background="#70FFFFFF"
                                BorderBrush="#40FFFFFF"
                                BorderThickness="1"
                                MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                                    <ScrollViewer MaxHeight="200">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="MainBorder" Property="Background" Value="#4000A6FB"/>
                                <Setter TargetName="MainBorder" Property="BorderBrush" Value="#6000A6FB"/>
                                <Setter TargetName="ArrowPath" Property="Fill" Value="#E6F5FF"/>
                            </Trigger>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="MainBorder" Property="BorderBrush" Value="#FF00A6FB"/>
                                <Setter TargetName="ArrowPath" Property="Fill" Value="#E6F5FF"/>
                            </Trigger>
                            <Trigger Property="IsDropDownOpen" Value="True">
                                <Setter TargetName="MainBorder" Property="Background" Value="#5000A6FB"/>
                                <Setter TargetName="MainBorder" Property="BorderBrush" Value="#FF00A6FB"/>
                                <Setter TargetName="ArrowPath" Property="Fill" Value="#E6F5FF"/>
                                <Setter TargetName="ArrowPath" Property="Data" Value="M 0 4 L 4 0 L 8 4 Z"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ComboBoxItem Style -->
        <Style x:Key="GlassComboBoxItem" TargetType="ComboBoxItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Bg" 
                                Background="{TemplateBinding Background}" 
                                Padding="{TemplateBinding Padding}"
                                CornerRadius="6">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#30FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#40FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- DataGrid Style -->
        <Style x:Key="ModernDataGrid" TargetType="DataGrid">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="GridLinesVisibility" Value="None"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
            <Setter Property="ScrollViewer.PanningMode" Value="Both"/>
            <Setter Property="Stylus.IsFlicksEnabled" Value="False"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="SelectionUnit" Value="FullRow"/>
        </Style>

        <!-- DataGridRow Style -->
        <Style x:Key="DataGridRowStyle" TargetType="DataGridRow">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#2000A6FB"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#4000A6FB"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Search and Filter Section -->
      <!-- SEARCH & FILTERS -->
<ContentControl Grid.Row="0" Template="{StaticResource GlassContainerTemplate}" Margin="0,0,0,15">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <!-- SEARCH BOX – FULLY CLICKABLE -->
                <!-- SEARCH BOX - FINAL VERSION WITH ICON + FULLY WORKING SEARCH -->
                <Border Grid.Column="0" 
        Background="#20FFFFFF" 
        CornerRadius="8" 
        BorderBrush="#40FFFFFF" 
        BorderThickness="1" 
        Margin="5" 
        Height="40">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Search Icon -->
                        <Path Grid.Column="0" 
              Data="M21.5 20L15.8 14.3C17.3 12.5 18 10.2 18 7.7 18 3.5 14.5 0 10.3 0 6.1 0 2.6 3.5 2.6 7.7 2.6 11.9 6.1 15.4 10.3 15.4 12.8 15.4 15.1 14.7 17 13.3L22.7 19 21.5 20ZM10.3 13.4C7.2 13.4 4.6 10.8 4.6 7.7 4.6 4.6 7.2 2 10.3 2 13.4 2 16 4.6 16 7.7 16 10.8 13.4 13.4 10.3 13.4Z"
              Fill="#88FFFFFF"
              Width="16" 
              Height="16"
              Stretch="Uniform"
              Margin="12,0,8,0"
              VerticalAlignment="Center"/>

                        <!-- TextBox -->
                        <TextBox x:Name="SearchBox"
                 Grid.Column="1"
                 Background="Transparent"
                 BorderThickness="0"
                 Foreground="White"
                 FontSize="14"
                 Padding="8,0,12,0"
                 VerticalContentAlignment="Center"
                 CaretBrush="White"
                 SelectionBrush="#6000A6FB"
                 TextChanged="SearchBox_TextChanged"/>

                        <!-- Placeholder Text -->
                        <TextBlock Grid.Column="1"
                   Text="Search employees..."
                   Foreground="#88FFFFFF"
                   Margin="8,0,0,0"
                   VerticalAlignment="Center"
                   FontSize="14"
                   IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </Border>

                <!-- ADD BUTTON -->
        <Button Grid.Column="3" Content="+ Add Employee"
                Style="{StaticResource ModernButton}"
                Margin="5" Height="40"
                Click="BtnAddEmployee_Click"/>


                <!-- Add Employee Button -->
                <Button Grid.Column="3" 
                        x:Name="BtnAddEmployee"
                        Content="+ Add Employee" 
                        Style="{StaticResource ModernButton}"
                        Margin="5"
                        Height="35"
                        Click="BtnAddEmployee_Click"/>
            </Grid>
        </ContentControl>

        <!-- Main Content Area -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="7*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="3*"/>
            </Grid.ColumnDefinitions>

            <!-- Employee Table -->
            <ContentControl Grid.Column="0" Template="{StaticResource GlassContainerTemplate}">
                <DataGrid x:Name="EmployeesGrid"
                          Style="{StaticResource ModernDataGrid}"
                          RowStyle="{StaticResource DataGridRowStyle}"
                          SelectionChanged="EmployeesGrid_SelectionChanged">

                    <DataGrid.Columns>
                                     <!-- Employee ID (EmpCode) -->
                        <DataGridTextColumn Header="Emp ID" Binding="{Binding EmpCode}" Width="110"/>

                        <!-- Full Name using MultiBinding (FirstName + LastName) -->
                        <DataGridTextColumn Header="Name" Width="130">
                            <DataGridTextColumn.Binding>
                                <MultiBinding StringFormat="{}{0} {1}">
                                    <Binding Path="FirstName"/>
                                    <Binding Path="LastName"/>
                                </MultiBinding>
                            </DataGridTextColumn.Binding>
                        </DataGridTextColumn>

                        <!-- Department -->
                        <DataGridTextColumn Header="Department" Binding="{Binding Department}" Width="130"/>

                        <!-- Position -->
                        <DataGridTextColumn Header="Position" Binding="{Binding Position}" Width="*"/>

                        <!-- Email -->
                        <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="200"/>

                        <!-- Status (Active/Inactive) with color -->
                        <DataGridTextColumn Header="Status" Binding="{Binding IsActive}" Width="100">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>

                    <DataGrid.CellStyle>
                        <Style TargetType="DataGridCell">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Padding" Value="10,8"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="DataGridCell">
                                        <Border Background="Transparent" Padding="10,8">
                                            <ContentPresenter VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </DataGrid.CellStyle>

                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Foreground" Value="#00A6FB"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Padding" Value="10,12"/>
                            <Setter Property="HorizontalContentAlignment" Value="Left"/>
                        </Style>
                    </DataGrid.ColumnHeaderStyle>
                </DataGrid>
            </ContentControl>

            <!-- Employee Form -->
            <ContentControl Grid.Column="2" 
                            Template="{StaticResource GlassContainerTemplate}"
                            x:Name="EmployeeFormContainer">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="10">
                        <TextBlock Text="Employee Details" 
                                   Foreground="#00A6FB" 
                                   FontSize="18" 
                                   FontWeight="Bold"
                                   Margin="0,0,0,15"/>

                        <StackPanel x:Name="EmployeeForm" Visibility="Collapsed">
                            <!-- Employee ID (Read-only for editing) -->
                            <TextBlock Text="Employee ID" 
                                       Foreground="White" 
                                       FontWeight="SemiBold"
                                       Margin="0,5,0,2"/>
                            <TextBox x:Name="TxtEmployeeID" 
                                     Style="{StaticResource ModernTextBox}"
                                     IsReadOnly="True"
                                     Background="#10000000"/>

                            <!-- First Name -->
                            <TextBlock Text="First Name *" 
                                       Foreground="White" 
                                       FontWeight="SemiBold"
                                       Margin="0,10,0,2"/>
                            <TextBox x:Name="TxtFirstName" 
                                     Style="{StaticResource ModernTextBox}"/>

                            <!-- Middle Name -->
                            <TextBlock Text="Middle Name" 
                                       Foreground="White" 
                                       FontWeight="SemiBold"
                                       Margin="0,10,0,2"/>
                            <TextBox x:Name="TxtMiddleName" 
                                     Style="{StaticResource ModernTextBox}"/>

                            <!-- Last Name -->
                            <TextBlock Text="Last Name *" 
                                       Foreground="White" 
                                       FontWeight="SemiBold"
                                       Margin="0,10,0,2"/>
                            <TextBox x:Name="TxtLastName" 
                                     Style="{StaticResource ModernTextBox}"/>

                            <!-- Department -->
                            <TextBlock Text="Department *" 
                                       Foreground="White" 
                                       FontWeight="SemiBold"
                                       Margin="0,10,0,2"/>
                            <TextBox x:Name="TxtDepartment" 
                                     Style="{StaticResource ModernTextBox}"/>

                            <!-- Position -->
                            <TextBlock Text="Position *" 
                                       Foreground="White" 
                                       FontWeight="SemiBold"
                                       Margin="0,10,0,2"/>
                            <TextBox x:Name="TxtPosition" 
                                     Style="{StaticResource ModernTextBox}"/>

                            <!-- Email -->
                            <TextBlock Text="Email *" 
                                       Foreground="White" 
                                       FontWeight="SemiBold"
                                       Margin="0,10,0,2"/>
                            <TextBox x:Name="TxtEmail" 
                                     Style="{StaticResource ModernTextBox}"/>

                            <!-- Phone -->
                            <TextBlock Text="Phone *" 
                                       Foreground="White" 
                                       FontWeight="SemiBold"
                                       Margin="0,10,0,2"/>
                            <TextBox x:Name="TxtPhone" 
                                     Style="{StaticResource ModernTextBox}"/>

                            <!-- Role -->
                            <TextBlock Text="Role *" 
                                       Foreground="White" 
                                       FontWeight="SemiBold"
                                       Margin="0,10,0,2"/>
                            <ComboBox x:Name="CmbRole" 
                                      Style="{StaticResource GlassComboBox}"
                                      ItemContainerStyle="{StaticResource GlassComboBoxItem}">
                                <ComboBoxItem Content="User"/>
                                <ComboBoxItem Content="Admin"/>
                                <ComboBoxItem Content="Manager"/>
                            </ComboBox>

                            <!-- Form Buttons - Dynamic based on mode -->
                            <StackPanel x:Name="EditModeButtons" 
                                        Orientation="Horizontal" 
                                        HorizontalAlignment="Stretch" 
                                        Margin="0,20,0,0">
                                <Button x:Name="BtnUpdate" 
                                        Content="Update" 
                                        Style="{StaticResource ModernButton}"
                                        Margin="0,0,10,0"
                                        Height="35"
                                        Click="BtnUpdate_Click"/>
                                <Button x:Name="BtnDelete" 
                                        Content="Delete" 
                                        Style="{StaticResource ModernButton}"
                                        Height="35"
                                        Background="#DC3545"
                                        Click="BtnDelete_Click"/>
                            </StackPanel>

                            <StackPanel x:Name="AddModeButtons" 
                                        Orientation="Horizontal" 
                                        HorizontalAlignment="Stretch" 
                                        Margin="0,20,0,0"
                                        Visibility="Collapsed">
                                <Button x:Name="BtnAdd" 
                                        Content="Add Employee" 
                                        Style="{StaticResource ModernButton}"
                                        Margin="0,0,10,0"
                                        Height="35"
                                        Click="BtnAdd_Click"/>
                                <Button x:Name="BtnCancel" 
                                        Content="Cancel" 
                                        Style="{StaticResource SecondaryButton}"
                                        Height="35"
                                        Click="BtnCancel_Click"/>
                            </StackPanel>

                            <!-- Required fields note -->
                            <TextBlock Text="* Required fields" 
                                       Foreground="#888888" 
                                       FontSize="11"
                                       Margin="0,10,0,0"
                                       FontStyle="Italic"/>
                        </StackPanel>

                        <!-- Empty State -->
                        <TextBlock x:Name="EmptyFormText" 
                                   Text="Select an employee to edit or click 'Add Employee' to create new"
                                   Foreground="#ced4da" 
                                   FontSize="14" 
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   Margin="0,50,0,0"/>
                    </StackPanel>
                </ScrollViewer>
            </ContentControl>
        </Grid>
    </Grid>
</UserControl>