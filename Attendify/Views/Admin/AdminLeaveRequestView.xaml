<UserControl x:Class="Attendify.Views.UserControls.LeaveRequestsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="800"
             Background="Transparent">

    <UserControl.Resources>

        <!-- Glass container style using standard Border -->
        <Style x:Key="GlassRoundedBorder" TargetType="Border">
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#13FFFFFF" Offset="0" />
                        <GradientStop Color="#13FFFFFF" Offset="1" />
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="BorderBrush" Value="#40FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="18" Opacity="0.18" ShadowDepth="2"/>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Glass Liquid Filter Button Style - Code-behind colors -->
        <Style x:Key="GlassFilterButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="15,6"/>
            <Setter Property="MinWidth" Value="70"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#20FFFFFF" Offset="0"/>
                        <GradientStop Color="#10FFFFFF" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" 
                        CornerRadius="16"
                        Background="{TemplateBinding Background}"
                        BorderBrush="#40FFFFFF"
                        BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                      Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Refresh Button Style (no border) -->
        <Style x:Key="RefreshButtonStyle" TargetType="Button" BasedOn="{StaticResource GlassFilterButtonStyle}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" 
                                CornerRadius="16"
                                Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#2000A6FB"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#4000A6FB"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Action Button Style using standard Border -->
        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#00A6FB"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" 
                                CornerRadius="8"
                                Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#0088CC"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#006699"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Status Badge Style using standard Border -->
        <Style x:Key="StatusBadgeStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
        </Style>

        <!-- Search Box Style using standard Border -->
        <Style x:Key="SearchBoxStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Background" Value="#20FFFFFF"/>
            <Setter Property="BorderBrush" Value="#40FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Height" Value="35"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,10,0,0">

            <!-- Filter Tabs -->
            <Border Style="{StaticResource GlassRoundedBorder}" Margin="0,0,0,15">
                <StackPanel Orientation="Horizontal" Height="40" VerticalAlignment="Center">
                    <!-- Filter Buttons with Glass Liquid Background - NO HARDCODED COLORS -->
                    <Button x:Name="BtnAll" Content="All" Style="{StaticResource GlassFilterButtonStyle}" 
                Margin="0,0,8,0" Click="FilterButton_Click" ToolTip="Show all requests"/>
                    <Button x:Name="BtnToday" Content="Today" Style="{StaticResource GlassFilterButtonStyle}" 
                Margin="0,0,8,0" Click="FilterButton_Click" ToolTip="Show today's requests"/>
                    <Button x:Name="BtnApproved" Content="Approved" Style="{StaticResource GlassFilterButtonStyle}" 
                Margin="0,0,8,0" Click="FilterButton_Click" ToolTip="Show approved requests"/>
                    <Button x:Name="BtnPending" Content="Pending" Style="{StaticResource GlassFilterButtonStyle}" 
                Margin="0,0,8,0"  Click="FilterButton_Click" ToolTip="Show pending requests"/>
                    <Button x:Name="BtnRejected" Content="Rejected" Style="{StaticResource GlassFilterButtonStyle}" 
                Margin="0,0,8,0" Click="FilterButton_Click" ToolTip="Show rejected requests"/>

                    <!-- Search Box -->
                    <Border Style="{StaticResource SearchBoxStyle}" 
                            Margin="20,0,10,0" VerticalAlignment="Center">
                        <Grid Width="200">
                            <TextBox x:Name="SearchBox" Background="Transparent" BorderThickness="0" 
                                    Foreground="White" FontSize="14" Padding="10,0" VerticalContentAlignment="Center"
                                    TextChanged="SearchBox_TextChanged"/>
                            <TextBlock x:Name="SearchPlaceholder" Text="Search Employees..." Foreground="#B0CFFF" 
                                      FontSize="14" Margin="10,0,0,0" VerticalAlignment="Center" 
                                      IsHitTestVisible="False"/>
                        </Grid>
                    </Border>

                    <!-- Refresh Button -->
                    <Button x:Name="BtnRefresh"
                            Content="⟳"
                            Style="{StaticResource RefreshButtonStyle}"
                            Background="Transparent"
                            Click="BtnRefresh_Click"
                            ToolTip="Refresh requests"
                            Margin="5,0,0,0"
                            FontSize="16"
                            Width="36"
                            Height="36"
                            Padding="0"/>
                </StackPanel>
            </Border>

            <!-- Main Content Grid -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="350"/>
                </Grid.ColumnDefinitions>

                <!-- Leave Requests Table -->
                <Border Grid.Column="0" Style="{StaticResource GlassRoundedBorder}" Margin="0,0,10,0">
                    <DataGrid x:Name="LeaveRequestsGrid"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              IsReadOnly="True"
                              Background="Transparent"
                              RowBackground="#20FFFFFF"
                              AlternatingRowBackground="#10FFFFFF"
                              GridLinesVisibility="None"
                              BorderThickness="0"
                              HeadersVisibility="Column"
                              SelectionMode="Single"
                              SelectionChanged="LeaveRequestsGrid_SelectionChanged"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Auto">

                        <DataGrid.Columns>
                            <!-- No Column - Fixed small width -->
                            <DataGridTextColumn Header="No" Binding="{Binding No}" Width="50" MinWidth="40">
                                <DataGridTextColumn.HeaderStyle>
                                    <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                                        <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                        <Setter Property="Foreground" Value="#00A6FB"/>
                                        <Setter Property="FontSize" Value="12"/>
                                        <Setter Property="Padding" Value="8,10"/>
                                        <Setter Property="Background" Value="Transparent"/>
                                    </Style>
                                </DataGridTextColumn.HeaderStyle>
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="Foreground" Value="White"/>
                                        <Setter Property="FontSize" Value="12"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- Employee Column - Responsive -->
                            <DataGridTextColumn Header="Employee" Binding="{Binding EmployeeName}" 
                        Width="2*" MinWidth="120" MaxWidth="200">
                                <DataGridTextColumn.HeaderStyle>
                                    <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                                        <Setter Property="HorizontalContentAlignment" Value="Left"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                        <Setter Property="Foreground" Value="#00A6FB"/>
                                        <Setter Property="FontSize" Value="12"/>
                                        <Setter Property="Padding" Value="8,10"/>
                                        <Setter Property="Background" Value="Transparent"/>
                                    </Style>
                                </DataGridTextColumn.HeaderStyle>
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="White"/>
                                        <Setter Property="FontSize" Value="12"/>
                                        <Setter Property="TextWrapping" Value="NoWrap"/>
                                        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- From Date Column - Fixed medium width -->
                            <DataGridTextColumn Header="From" Binding="{Binding FromDate}" 
                        Width="0.8*" MinWidth="80" MaxWidth="100">
                                <DataGridTextColumn.HeaderStyle>
                                    <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                                        <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                        <Setter Property="Foreground" Value="#00A6FB"/>
                                        <Setter Property="FontSize" Value="12"/>
                                        <Setter Property="Padding" Value="8,10"/>
                                        <Setter Property="Background" Value="Transparent"/>
                                    </Style>
                                </DataGridTextColumn.HeaderStyle>
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="Foreground" Value="White"/>
                                        <Setter Property="FontSize" Value="12"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- To Date Column - Fixed medium width -->
                            <DataGridTextColumn Header="To" Binding="{Binding ToDate}" 
                        Width="0.8*" MinWidth="80" MaxWidth="100">
                                <DataGridTextColumn.HeaderStyle>
                                    <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                                        <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                        <Setter Property="Foreground" Value="#00A6FB"/>
                                        <Setter Property="FontSize" Value="12"/>
                                        <Setter Property="Padding" Value="8,10"/>
                                        <Setter Property="Background" Value="Transparent"/>
                                    </Style>
                                </DataGridTextColumn.HeaderStyle>
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="Foreground" Value="White"/>
                                        <Setter Property="FontSize" Value="12"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- Reason Column - Most responsive -->
                            <DataGridTextColumn Header="Reason" Binding="{Binding Reason}" 
                        Width="3*" MinWidth="150" MaxWidth="300">
                                <DataGridTextColumn.HeaderStyle>
                                    <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                                        <Setter Property="HorizontalContentAlignment" Value="Left"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                        <Setter Property="Foreground" Value="#00A6FB"/>
                                        <Setter Property="FontSize" Value="12"/>
                                        <Setter Property="Padding" Value="8,10"/>
                                        <Setter Property="Background" Value="Transparent"/>
                                    </Style>
                                </DataGridTextColumn.HeaderStyle>
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="White"/>
                                        <Setter Property="FontSize" Value="12"/>
                                        <Setter Property="TextWrapping" Value="Wrap"/>
                                        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- Status Column - Fixed width -->
                            <DataGridTemplateColumn Header="Status" Width="100" MinWidth="90" MaxWidth="120">
                                <DataGridTemplateColumn.HeaderStyle>
                                    <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                                        <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                        <Setter Property="Foreground" Value="#00A6FB"/>
                                        <Setter Property="FontSize" Value="12"/>
                                        <Setter Property="Padding" Value="8,10"/>
                                        <Setter Property="Background" Value="Transparent"/>
                                    </Style>
                                </DataGridTemplateColumn.HeaderStyle>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <!-- StatusColor is a string from API (e.g., "#2FBF4C") -->
                                        <Border Style="{StaticResource StatusBadgeStyle}" 
        Background="{Binding StatusBrush}"
        Margin="2">
                                            <TextBlock Text="{Binding Status}" 
                               Foreground="White" 
                               FontWeight="SemiBold" 
                               FontSize="11"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                        <DataGrid.CellStyle>
                            <Style TargetType="DataGridCell">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Padding" Value="8,6"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="DataGridCell">
                                            <Border Background="Transparent" Padding="8,6">
                                                <ContentPresenter VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="#4000A6FB"/>
                                        <Setter Property="BorderBrush" Value="#00A6FB"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.CellStyle>

                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Foreground" Value="#00A6FB"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="FontSize" Value="12"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Padding" Value="8,10"/>
                                <Setter Property="HorizontalContentAlignment" Value="Left"/>
                            </Style>
                        </DataGrid.ColumnHeaderStyle>

                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Setter Property="MinHeight" Value="35"/>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#3000A6FB"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                    </DataGrid>
                </Border>

                <!-- Detailed View -->
                <Border Grid.Column="1" Style="{StaticResource GlassRoundedBorder}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="10">
                            <TextBlock Text="Detailed View" Foreground="#00A6FB" FontSize="18" FontWeight="Bold" 
                                      Margin="0,0,0,15"/>

                            <StackPanel x:Name="DetailedViewPanel" Visibility="Collapsed">
                                <!-- Employee Details -->
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Emp Id -->
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Emp Id:" Foreground="White" 
                                              FontWeight="SemiBold" Margin="0,0,10,8"/>
                                    <TextBlock Grid.Row="0" Grid.Column="1" x:Name="DetailEmpId" Foreground="#CCCCCC" 
                                              Margin="0,0,0,8"/>

                                    <!-- Employee -->
                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Employee:" Foreground="White" 
                                              FontWeight="SemiBold" Margin="0,0,10,8"/>
                                    <TextBlock Grid.Row="1" Grid.Column="1" x:Name="DetailEmployee" Foreground="#CCCCCC" 
                                              Margin="0,0,0,8"/>

                                    <!-- Department -->
                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Department:" Foreground="White" 
                                              FontWeight="SemiBold" Margin="0,0,10,8"/>
                                    <TextBlock Grid.Row="2" Grid.Column="1" x:Name="DetailDepartment" Foreground="#CCCCCC" 
                                              Margin="0,0,0,8"/>

                                    <!-- Position -->
                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Position:" Foreground="White" 
                                              FontWeight="SemiBold" Margin="0,0,10,8"/>
                                    <TextBlock Grid.Row="3" Grid.Column="1" x:Name="DetailPosition" Foreground="#CCCCCC" 
                                              Margin="0,0,0,8"/>

                                    <!-- Email -->
                                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Email:" Foreground="White" 
                                              FontWeight="SemiBold" Margin="0,0,10,8"/>
                                    <TextBlock Grid.Row="4" Grid.Column="1" x:Name="DetailEmail" Foreground="#CCCCCC" 
                                              Margin="0,0,0,8"/>

                                    <!-- From Date -->
                                    <TextBlock Grid.Row="5" Grid.Column="0" Text="From Date:" Foreground="White" 
                                              FontWeight="SemiBold" Margin="0,0,10,8"/>
                                    <TextBlock Grid.Row="5" Grid.Column="1" x:Name="DetailFromDate" Foreground="#CCCCCC" 
                                              Margin="0,0,0,8"/>

                                    <!-- To Date -->
                                    <TextBlock Grid.Row="6" Grid.Column="0" Text="To Date:" Foreground="White" 
                                              FontWeight="SemiBold" Margin="0,0,10,8"/>
                                    <TextBlock Grid.Row="6" Grid.Column="1" x:Name="DetailToDate" Foreground="#CCCCCC" 
                                              Margin="0,0,0,8"/>

                                    <!-- Reason -->
                                    <TextBlock Grid.Row="7" Grid.Column="0" Text="Reason:" Foreground="White" 
                                              FontWeight="SemiBold" Margin="0,0,10,8"/>
                                    <TextBlock Grid.Row="7" Grid.Column="1" x:Name="DetailReason" Foreground="#CCCCCC" 
                                              TextWrapping="Wrap" Margin="0,0,0,8"/>

                                    <!-- Details -->
                                    <TextBlock Grid.Row="8" Grid.Column="0" Text="Details:" Foreground="White" 
                                              FontWeight="SemiBold" Margin="0,0,10,8"/>
                                    <TextBlock Grid.Row="8" Grid.Column="1" x:Name="DetailDescription" 
                                               Foreground="#CCCCCC" 
                                               TextWrapping="Wrap"
                                               FontSize="12"
                                               Margin="0,0,0,8"/>

                                    <!-- Status -->
                                    <TextBlock Grid.Row="9" Grid.Column="0" Text="Status:" Foreground="White" 
                                              FontWeight="SemiBold" Margin="0,0,10,8"/>
                                    <Border Grid.Row="9" Grid.Column="1" x:Name="DetailStatusBorder" 
                                            Style="{StaticResource StatusBadgeStyle}" HorizontalAlignment="Left">
                                        <TextBlock x:Name="DetailStatus" Foreground="White" FontWeight="SemiBold"/>
                                    </Border>

                                    <!-- Rejection Reason Input (Visible only when rejecting) -->
                                    <StackPanel x:Name="RejectionReasonPanel" Grid.Row="10" Grid.Column="0" Grid.ColumnSpan="2" 
            Orientation="Vertical" Margin="0,15,0,0" Visibility="Collapsed">
                                        <TextBlock Text="Rejection Reason:" Foreground="White" 
               FontWeight="SemiBold" Margin="0,0,0,8"/>

                                        <Border Background="#20FFFFFF"
            BorderBrush="#40FFFFFF"
            BorderThickness="1"
            CornerRadius="6"
            Padding="10,8">
                                            <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="100">
                                                <TextBox x:Name="RejectionReasonTextBox"
                     Background="Transparent"
                     Foreground="White"
                     BorderThickness="0"
                     FontSize="12"
                     TextWrapping="Wrap"
                     MinHeight="60"
                     VerticalAlignment="Top"/>
                                            </ScrollViewer>
                                        </Border>

                                        <!-- Placeholder Text -->
                                        <TextBlock x:Name="RejectionPlaceholder" 
               Text="Enter reason for rejection..."
               Foreground="#B0CFFF"
               FontSize="12"
               Margin="10,8,0,-30"
               IsHitTestVisible="False"
               VerticalAlignment="Top"/>
                                    </StackPanel>

                                    <!-- Action Buttons -->
                                    <StackPanel Grid.Row="11" Grid.Column="0" Grid.ColumnSpan="2" 
                                                Orientation="Horizontal" Margin="0,15,0,0" HorizontalAlignment="Center">
                                        <Button x:Name="BtnApprove" Content="Approve" Style="{StaticResource ActionButtonStyle}"
                                                Background="#28A745" Click="BtnApprove_Click" Margin="0,0,10,0"/>
                                        <Button x:Name="BtnReject" Content="Reject" Style="{StaticResource ActionButtonStyle}"
                                                Background="#DC3545" Click="BtnReject_Click"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>

                            <!-- Empty State -->
                            <TextBlock x:Name="EmptyStateText" Text="Select a leave request to view details" 
                                      Foreground="#888888" FontSize="14" TextAlignment="Center" 
                                      HorizontalAlignment="Center" VerticalAlignment="Center" 
                                      Margin="0,50,0,0"/>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>