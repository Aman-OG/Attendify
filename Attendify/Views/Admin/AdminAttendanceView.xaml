<UserControl x:Class="Attendify.Views.UserControls.AttendanceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="900"
             Background="Transparent">

    <UserControl.Resources>
        <!-- Glass container style -->
        <ControlTemplate x:Key="GlassContainerTemplate" TargetType="ContentControl">
            <Grid>
                <Border CornerRadius="10">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#33FFFFFF" Offset="0" />
                            <GradientStop Color="#13FFFFFF" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="18" Opacity="0.18" ShadowDepth="2"/>
                    </Border.Effect>
                </Border>
                <Border CornerRadius="10" Padding="12" Background="#22FFFFFF" BorderBrush="#40FFFFFF" BorderThickness="1">
                    <ContentPresenter />
                </Border>
            </Grid>
        </ControlTemplate>

        <!-- SIMPLE WORKING COMBOBOX STYLE -->
        <Style x:Key="GlassComboBox" TargetType="ComboBox">
            <Setter Property="Background" Value="#20FFFFFF"/>
            <Setter Property="BorderBrush" Value="#40FFFFFF"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <!-- Main border with rounded corners -->
                            <Border x:Name="MainBorder"
                            CornerRadius="10"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="30"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Content -->
                                    <ContentPresenter Grid.Column="0"
                                              HorizontalAlignment="Left"
                                              VerticalAlignment="Center"
                                              Margin="12,0,0,0"
                                              Content="{TemplateBinding SelectionBoxItem}"/>

                                    <!-- Arrow -->
                                    <Path x:Name="ArrowPath"
                                  Grid.Column="1"
                                  Fill="White"
                                  Data="M 0 0 L 4 4 L 8 0 Z"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  Width="8" Height="6"/>
                                </Grid>
                            </Border>

                            <!-- Toggle Button - Make it NOT cover the entire area -->
                            <ToggleButton x:Name="ToggleButton"
                                  Background="Transparent"
                                  BorderBrush="Transparent"
                                  HorizontalAlignment="Right"
                                  VerticalAlignment="Stretch"
                                  Width="40"
                                  IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"/>

                            <!-- Dropdown Popup -->
                            <Popup x:Name="PART_Popup"
                           Placement="Bottom"
                           IsOpen="{TemplateBinding IsDropDownOpen}"
                           AllowsTransparency="True"
                           PopupAnimation="Slide">
                                <Border CornerRadius="10"
                                Background="#70FFFFFF"
                                BorderBrush="#40FFFFFF"
                                BorderThickness="1"
                                MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                                    <ScrollViewer MaxHeight="200">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="MainBorder" Property="Background" Value="#4000A6FB"/>
                                <Setter TargetName="MainBorder" Property="BorderBrush" Value="#6000A6FB"/>
                                <Setter TargetName="ArrowPath" Property="Fill" Value="#E6F5FF"/>
                            </Trigger>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="MainBorder" Property="BorderBrush" Value="#FF00A6FB"/>
                                <Setter TargetName="ArrowPath" Property="Fill" Value="#E6F5FF"/>
                            </Trigger>
                            <Trigger Property="IsDropDownOpen" Value="True">
                                <Setter TargetName="MainBorder" Property="Background" Value="#5000A6FB"/>
                                <Setter TargetName="MainBorder" Property="BorderBrush" Value="#FF00A6FB"/>
                                <Setter TargetName="ArrowPath" Property="Fill" Value="#E6F5FF"/>
                                <Setter TargetName="ArrowPath" Property="Data" Value="M 0 4 L 4 0 L 8 4 Z"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ComboBoxItem Style -->
        <Style x:Key="GlassComboBoxItem" TargetType="ComboBoxItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Bg" 
                                Background="{TemplateBinding Background}" 
                                Padding="{TemplateBinding Padding}"
                                CornerRadius="6">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#30FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#40FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Status Card Style -->
        <Style x:Key="StatusCardStyle" TargetType="Border">
            <Setter Property="Background" Value="#20FFFFFF"/>
            <Setter Property="BorderBrush" Value="#40FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="20,15"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <!-- DataGrid Style -->
        <Style x:Key="ModernDataGrid" TargetType="DataGrid">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="GridLinesVisibility" Value="None"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
            <Setter Property="ScrollViewer.PanningMode" Value="Both"/>
            <Setter Property="Stylus.IsFlicksEnabled" Value="False"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="SelectionUnit" Value="FullRow"/>
        </Style>

        <!-- DataGridRow Style -->
        <Style x:Key="DataGridRowStyle" TargetType="DataGridRow">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#2000A6FB"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#4000A6FB"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- TextBox Style -->
        <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="#20FFFFFF"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#40FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost" 
                                          Margin="{TemplateBinding Padding}"
                                          Background="Transparent"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#00A6FB"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Refresh Button Style -->
        <Style x:Key="RefreshButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#00A6FB"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}"
                                CornerRadius="20"
                                Width="40" Height="40">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#2000A6FB"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Search and Filter Section -->
        <ContentControl Grid.Row="0" Template="{StaticResource GlassContainerTemplate}" Margin="0,0,0,15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Search Box -->
                <Border Grid.Column="0" 
                        Background="#20FFFFFF" 
                        CornerRadius="8" 
                        BorderBrush="#40FFFFFF" 
                        BorderThickness="1"
                        Margin="5"
                        VerticalAlignment="Center">
                    <Grid>
                        <TextBox x:Name="SearchBox" 
                                 Style="{StaticResource ModernTextBox}"
                                 BorderThickness="0"
                                 Padding="15,8"
                                 TextChanged="SearchBox_TextChanged"/>
                        <TextBlock x:Name="SearchPlaceholder" 
                                   Text="🔍 Search employees..." 
                                   Foreground="#B0CFFF"
                                   Margin="15,0,0,0"
                                   VerticalAlignment="Center"
                                   IsHitTestVisible="False"/>
                    </Grid>
                </Border>

                <!-- Department Filter -->
                <ComboBox Grid.Column="1" 
                          x:Name="DepartmentFilter"
                          Style="{StaticResource GlassComboBox}"
                          Width="140"
                          Margin="5"
                          ItemContainerStyle="{StaticResource GlassComboBoxItem}"
                          SelectionChanged="FilterComboBox_SelectionChanged">
                    <ComboBoxItem Content="Department" IsSelected="True"/>
                    <ComboBoxItem Content="All Departments"/>
                    <ComboBoxItem Content="Software"/>
                    <ComboBoxItem Content="Electrical"/>
                    <ComboBoxItem Content="Chemical"/>
                    <ComboBoxItem Content="HR"/>
                    <ComboBoxItem Content="Finance"/>
                </ComboBox>

                <!-- Position Filter -->
                <ComboBox Grid.Column="2" 
                          x:Name="PositionFilter"
                          Style="{StaticResource GlassComboBox}"
                          Width="120"
                          Margin="5"
                          ItemContainerStyle="{StaticResource GlassComboBoxItem}"
                          SelectionChanged="FilterComboBox_SelectionChanged">
                    <ComboBoxItem Content="Position" IsSelected="True"/>
                    <ComboBoxItem Content="All Positions"/>
                    <ComboBoxItem Content="Manager"/>
                    <ComboBoxItem Content="Developer"/>
                    <ComboBoxItem Content="Engineer"/>
                    <ComboBoxItem Content="Analyst"/>
                </ComboBox>
                <!-- Status Filter -->
                <ComboBox Grid.Column="3" 
          x:Name="StatusFilter"
          Style="{StaticResource GlassComboBox}"
          Width="120"
          Margin="5"
          ItemContainerStyle="{StaticResource GlassComboBoxItem}"
          SelectionChanged="FilterComboBox_SelectionChanged">
                    <ComboBoxItem Content="Status" IsSelected="True"/>
                    <ComboBoxItem Content="All Status"/>
                    <ComboBoxItem Content="Present"/>
                    <ComboBoxItem Content="Late"/>
                    <ComboBoxItem Content="On Leave"/>
                    <ComboBoxItem Content="Absent"/>
                </ComboBox>
            </Grid>
        </ContentControl>

        <!-- Status Cards -->
        <ContentControl Grid.Row="1" Template="{StaticResource GlassContainerTemplate}" Margin="0,0,0,15">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <!-- Present Card -->
                <Border x:Name="PresentCard" 
                Style="{StaticResource StatusCardStyle}"
                Background="#2028A745"
                BorderBrush="#4028A745"
                MouseLeftButtonDown="StatusCard_MouseLeftButtonDown">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="12" Height="12" Fill="#28A745" Margin="0,0,10,0"/>
                        <TextBlock>
                    <Run Text="Present" Foreground="White" FontWeight="Bold"/>
                    <Run Text=" (" Foreground="#CCCCCC"/>
                    <Run x:Name="PresentCount" Text="0" Foreground="White" FontWeight="Bold"/>
                    <Run Text=")" Foreground="#CCCCCC"/>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <!-- Late Card -->
                <Border x:Name="LateCard" 
                Style="{StaticResource StatusCardStyle}"
                Background="#20FFC107"
                BorderBrush="#40FFC107"
                MouseLeftButtonDown="StatusCard_MouseLeftButtonDown">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="12" Height="12" Fill="#FFC107" Margin="0,0,10,0"/>
                        <TextBlock>
                    <Run Text="Late" Foreground="White" FontWeight="Bold"/>
                    <Run Text=" (" Foreground="#CCCCCC"/>
                    <Run x:Name="LateCount" Text="0" Foreground="White" FontWeight="Bold"/>
                    <Run Text=")" Foreground="#CCCCCC"/>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <!-- On Leave Card -->
                <Border x:Name="OnLeaveCard" 
                Style="{StaticResource StatusCardStyle}"
                Background="#20007BFF"
                BorderBrush="#40007BFF"
                MouseLeftButtonDown="StatusCard_MouseLeftButtonDown">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="12" Height="12" Fill="#007BFF" Margin="0,0,10,0"/>
                        <TextBlock>
                    <Run Text="On Leave" Foreground="White" FontWeight="Bold"/>
                    <Run Text=" (" Foreground="#CCCCCC"/>
                    <Run x:Name="OnLeaveCount" Text="0" Foreground="White" FontWeight="Bold"/>
                    <Run Text=")" Foreground="#CCCCCC"/>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <!-- Absent Card -->
                <Border x:Name="AbsentCard" 
                Style="{StaticResource StatusCardStyle}"
                Background="#20DC3545"
                BorderBrush="#40DC3545"
                MouseLeftButtonDown="StatusCard_MouseLeftButtonDown">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="12" Height="12" Fill="#DC3545" Margin="0,0,10,0"/>
                        <TextBlock>
                    <Run Text="Absent" Foreground="White" FontWeight="Bold"/>
                    <Run Text=" (" Foreground="#CCCCCC"/>
                    <Run x:Name="AbsentCount" Text="0" Foreground="White" FontWeight="Bold"/>
                    <Run Text=")" Foreground="#CCCCCC"/>
                        </TextBlock>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ContentControl>

        <!-- Attendance Table -->
        <ContentControl Grid.Row="2" Template="{StaticResource GlassContainerTemplate}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Table Header -->
                <Border Grid.Row="0" 
                        Background="Transparent" 
                        Padding="10,15"
                        BorderBrush="#40FFFFFF" 
                        BorderThickness="0,0,0,1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="Attendance Table" 
                                   Foreground="#00A6FB" 
                                   FontSize="16" 
                                   FontWeight="Bold"
                                   VerticalAlignment="Center"/>

                        <Button Grid.Column="1"
                                x:Name="BtnRefresh"
                                Content="⟳"
                                Style="{StaticResource RefreshButtonStyle}"
                                FontSize="16"
                                FontWeight="Bold"
                                Click="BtnRefresh_Click"
                                ToolTip="Refresh attendance data"/>
                    </Grid>
                </Border>

                <!-- DataGrid -->
                <DataGrid Grid.Row="1"
                          x:Name="AttendanceGrid"
                          Style="{StaticResource ModernDataGrid}"
                          RowStyle="{StaticResource DataGridRowStyle}">

                    <DataGrid.Columns>
                        <DataGridTextColumn Header="EmpID" Binding="{Binding EmployeeID}" Width="80"/>
                        <DataGridTextColumn Header="Name" Width="*">
                            <DataGridTextColumn.Binding>
                                <MultiBinding StringFormat="{}{0} {1}">
                                    <Binding Path="FirstName"/>
                                    <Binding Path="LastName"/>
                                </MultiBinding>
                            </DataGridTextColumn.Binding>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Department" Binding="{Binding Department}" Width="120"/>
                        <DataGridTextColumn Header="Position" Binding="{Binding Position}" Width="120"/>
                        <DataGridTemplateColumn Header="Status" Width="120">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Ellipse Width="8" Height="8" Fill="{Binding StatusColor}" Margin="0,0,8,0"/>
                                        <TextBlock Text="{Binding Status}" Foreground="White" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>

                    <DataGrid.CellStyle>
                        <Style TargetType="DataGridCell">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Padding" Value="10,8"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="DataGridCell">
                                        <Border Background="Transparent" Padding="10,8">
                                            <ContentPresenter VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </DataGrid.CellStyle>

                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Foreground" Value="#00A6FB"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Padding" Value="10,12"/>
                            <Setter Property="HorizontalContentAlignment" Value="Left"/>
                        </Style>
                    </DataGrid.ColumnHeaderStyle>
                </DataGrid>
            </Grid>
        </ContentControl>
    </Grid>
</UserControl>