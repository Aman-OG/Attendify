<Window x:Class="Attendify.Views.SplashScreen"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Attendify.Views"
        mc:Ignorable="d"
        Title="SplashScreen"         WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        Width="680" Height="450"
        WindowStartupLocation="CenterScreen"
        Topmost="True">
    <Grid>

        <!-- Background Image -->
        <Image Source="/Assets/Images/Attendifysplah.png"
               Stretch="Fill" />

        <!-- Circular Progress Ring -->
        <ProgressBar x:Name="LoaderBar"
                     Width="400"
                     Height="8"
                     Margin="0,390,0,0"
                     VerticalAlignment="Top"
                     Foreground="#FFFFFFFF"
                     Background="#33FFFFFF"
                     Value="0"
                     Maximum="100"
                     />

    </Grid>
</Window>
